    <description>Auto-sends Stripe payment link email to customer when MuleSoft populates Stripe_Payment_URL__c on Invoice. HTML email with Make Payment button. Triggers when Stripe_Payment_URL__c becomes non-null (i.e., after Mule writes Stripe Checkout URL back). Falls back to demo-recipient@example.com if BillToContact.Email is null (demo safety).</description>
    <formulas>
        <name>RecipientEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.BillToContact.Email}), &quot;demo-recipient@example.com&quot;, {!$Record.BillToContact.Email})</expression>
    </formulas>
    <interviewLabel>Send Stripe Payment Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Stripe Payment Email</label>
    <processMetadataValues>
        <name>BuilderType</name>
