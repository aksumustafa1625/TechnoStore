    <decisions>
        <name>Is_Contract_Negotiating</name>
        <label>Is Contract in Negotiating?</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>Wrong_Status_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contract.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Negotiating</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Signer_Email_Screen</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Sends the Contract for e-signature: validates Status=Negotiating, captures signer email, transitions Contract to Awaiting Signature. Bypasses the broken CLM Send for Signature state action.</description>
    <interviewLabel>Send Contract for Signature {!$Flow.CurrentDateTime}</interviewLabel>
