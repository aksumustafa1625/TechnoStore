    <decisions>
        <name>Is_Contract_Awaiting_Signature</name>
        <label>Is Contract in Awaiting Signature?</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>Wrong_Status_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contract.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Signature</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Confirm_Screen</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Marks the contract as Signed (Awaiting Signature to Signed). Simulates the DocuSign webhook callback in orgs without e-signature integration. Bypasses the broken CLM Update Envelope Status state action.</description>
