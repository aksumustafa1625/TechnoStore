    <description>Sends an order shipping notification email when an Invoice with Fulfillment_Type=Physical transitions to Stripe_Payment_Status=Paid. Falls back to demo-recipient@example.com if BillToContact.Email is null.</description>
    <formulas>
        <name>ShippingRecipientEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.BillToContact.Email}), &quot;demo-recipient@example.com&quot;, {!$Record.BillToContact.Email})</expression>
    </formulas>
    <interviewLabel>Send Shipping Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Shipping Notification</label>
    <processMetadataValues>
        <name>BuilderType</name>
