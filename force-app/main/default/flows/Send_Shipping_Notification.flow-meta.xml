    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Shipping_Notification</targetReference>
        </connector>
        <filterFormula>AND(ISCHANGED({!$Record.Stripe_Payment_Status__c}), ISPICKVAL({!$Record.Stripe_Payment_Status__c}, &quot;Paid&quot;), {!$Record.Has_Physical__c}, NOT({!$Record.Has_Digital__c}))</filterFormula>
        <object>Invoice</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
