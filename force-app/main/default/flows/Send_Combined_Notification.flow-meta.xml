0&quot;&gt;&lt;tr&gt;&lt;td width=&quot;38&quot; height=&quot;38&quot; style=&quot;background-color:#10B981;border-radius:8px;text-align:center;color:#ffffff;font-size:20px;font-weight:900;line-height:38px;&quot;&gt;&amp;#128273;&lt;/td&gt;&lt;td style=&quot;padding-left:12px;vertical-align:middle;&quot;&gt;&lt;div style=&quot;color:#10B981;font-size:18px;font-weight:700;&quot;&gt;License Activated&lt;/div&gt;&lt;div style=&quot;color:#065f46;font-size:11px;letter-spacing:1.5px;font-weight:600;margin-top:2px;&quot;&gt;DIGITAL ITEMS &amp;middot; SAAS LICENSE&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding-top:16px;&quot;&gt;&lt;p style=&quot;font-size:14px;color:#374151;line-height:1.6;margin:0 0 8px 0;&quot;&gt;Your SaaS license is provisioned and ready to use. Sign in any time to start configuring your account &amp; APIs.&lt;/p&gt;&lt;table width=&quot;100%&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;margin-top:8px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 0;color:#6b7280;font-size:13px;&quot;&gt;Service Type&lt;/td&gt;&lt;td style=&quot;padding:4px 0;color:#10B981;font-size:13px;font-weight:700;text-align:right;&quot;&gt;SaaS License&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 0;color:#6b7280;font-size:13px;&quot;&gt;License Status&lt;/td&gt;&lt;td style=&quot;padding:4px 0;color:#10B981;font-size:13px;font-weight:700;text-align:right;&quot;&gt;&amp;#128273; ACTIVE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px 0;color:#6b7280;font-size:13px;&quot;&gt;Onboarding&lt;/td&gt;&lt;td style=&quot;padding:4px 0;color:#111827;font-size:13px;font-weight:600;text-align:right;&quot;&gt;Success manager &amp;lt; 24h&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;table width=&quot;100%&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;margin-top:14px;&quot;&gt;&lt;tr&gt;&lt;td align=&quot;center&quot;&gt;&lt;a href=&quot;https://example.com/portal&quot; style=&quot;display:inline-block;padding:11px 28px;background-color:#10B981;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;font-size:13px;&quot;&gt;Access Your Dashboard&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style=&quot;color:#9ca3af;font-size:12px;line-height:1.5;margin:24px 0 0 0;border-top:1px solid #e5e7eb;padding-top:20px;&quot;&gt;Need help with either part of your order? Email &lt;a href=&quot;mailto:support@technostore.com&quot; style=&quot;color:#5469D4;text-decoration:none;&quot;&gt;support@technostore.com&lt;/a&gt; — we will route your question to the right team automatically.&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#f9fafb;padding:24px 40px;border-top:1px solid #e5e7eb;&quot;&gt;&lt;p style=&quot;color:#6b7280;font-size:12px;line-height:1.6;margin:0;text-align:center;&quot;&gt;&amp;copy; 2026 TechnoStore &amp;mdash; Retail Excellence&lt;br/&gt;Powered by Salesforce Revenue Cloud, Stripe, MuleSoft &amp; Sendcloud&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/body&gt;&lt;/html&gt;</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>CombinedRecipientEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Your TechnoStore Bundle is Ready — Hardware Shipping &amp; License Active (Invoice {!$Record.DocumentNumber})</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>
    <description>Sends a single combined email when an Invoice has BOTH Has_Physical and Has_Digital and transitions to Stripe_Payment_Status=Paid. Body shows shipping section + license activation section stacked vertically. Falls back to demo-recipient@example.com if BillToContact.Email is null.</description>
    <formulas>
        <name>CombinedRecipientEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.BillToContact.Email}), &quot;demo-recipient@example.com&quot;, {!$Record.BillToContact.Email})</expression>
    </formulas>
    <interviewLabel>Send Combined Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Combined Notification</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Combined_Notification</targetReference>
        </connector>
        <filterFormula>AND(ISCHANGED({!$Record.Stripe_Payment_Status__c}), ISPICKVAL({!$Record.Stripe_Payment_Status__c}, &quot;Paid&quot;), {!$Record.Has_Physical__c}, {!$Record.Has_Digital__c})</filterFormula>
        <object>Invoice</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
