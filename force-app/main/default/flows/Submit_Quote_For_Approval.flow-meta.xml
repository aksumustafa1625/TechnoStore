        <locationY>710</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>comments</name>
            <value>
                <elementReference>Comments</elementReference>
            </value>
        </inputParameters>
        <connector>
            <targetReference>Manager_Approval_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
    </actionCalls>
    <apiVersion>63.0</apiVersion>
    <decisions>
        <name>Is_Quote_Draft</name>
        <label>Is Quote in Draft?</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>Wrong_Status_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Draft</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Draft</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Needs_Manager_Approval</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Needs_Manager_Approval</name>
        <label>Needs Manager Approval?</label>
        <locationX>176</locationX>
        <locationY>422</locationY>
        <defaultConnector>
            <targetReference>Auto_Approve_Quote</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No (Discount &lt;= 20%)</defaultConnectorLabel>
        <rules>
            <name>Over_Threshold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.Discount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>20.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Comments_Screen</targetReference>
            </connector>
            <label>Yes (Discount &gt; 20%)</label>
        </rules>
    </decisions>
    <description>Submits the Quote for approval with a discount-threshold rule. If Quote.Discount &gt; 20% the standard approval process runs (manager approval). Otherwise the quote is auto-approved (Status=Approved) without a human in the loop. Entry point = Quick Action on Quote layout.</description>
    <interviewLabel>Submit Quote for Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Submit Quote for Approval</label>
