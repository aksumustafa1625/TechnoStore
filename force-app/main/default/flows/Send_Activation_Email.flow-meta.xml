    <description>Auto-sends a payment confirmation / service activation email when an Invoice transitions to Stripe_Payment_Status__c=Paid. Falls back to demo@technostore.example if BillToContact.Email is null.</description>
    <formulas>
        <name>WelcomeRecipientEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.BillToContact.Email}), &quot;demo@technostore.example&quot;, {!$Record.BillToContact.Email})</expression>
    </formulas>
    <interviewLabel>Send Activation Email {!$Flow.CurrentDateTime}</interviewLabel>
