    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Activation_Email</targetReference>
        </connector>
        <filterFormula>AND(ISCHANGED({!$Record.Stripe_Payment_Status__c}), ISPICKVAL({!$Record.Stripe_Payment_Status__c}, &quot;Paid&quot;), {!$Record.Has_Digital__c}, NOT({!$Record.Has_Physical__c}))</filterFormula>
        <object>Invoice</object>
