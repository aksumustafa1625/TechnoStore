            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Customer_Email__c</field>
            <value>
                <elementReference>Get_Invoice.Customer_Email__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Customer_Name__c</field>
            <value>
                <elementReference>Get_Invoice.Account__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Invoice_Id__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Invoice_Number__c</field>
            <value>
                <elementReference>Get_Invoice.Name</elementReference>
            </value>
        </inputAssignments>
        <object>Invoice_Payment_Requested__e</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
