<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <actionCalls>
        <name>Send_Envelope</name>
        <label>Send Envelope</label>
        <locationX>176</locationX>
        <locationY>410</locationY>
        <actionName>DocuSignSendForSignatureService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Was_Send_Successful</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>contractId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientName</name>
            <value>
                <elementReference>Get_Contact.Name</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientEmail</name>
            <value>
                <elementReference>Get_Contact.Email</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <decisions>
        <name>Was_Send_Successful</name>
        <label>Was Send Successful?</label>
        <locationX>176</locationX>
        <locationY>530</locationY>
        <defaultConnector>
            <targetReference>Result_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Send_Envelope.status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>sent</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contract_Status</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Custom Send for Signature - one-click button. Auto-resolves recipient from Account's first contact with email. Updates Contract.Status to Awaiting Signature on successful send.</description>
    <environments>Default</environments>
    <interviewLabel>Send Contract Via DocuSign {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Contract Via DocuSign</label>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Contract</name>
        <label>Get Contract</label>
        <locationX>176</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contract</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contact</name>
        <label>Get Contact</label>
        <locationX>176</locationX>
        <locationY>170</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Confirm_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contract.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Contract_Status</name>
        <label>Update Contract Status to Awaiting Signature</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <connector>
            <targetReference>Result_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Awaiting Signature</stringValue>
            </value>
        </inputAssignments>
        <object>Contract</object>
    </recordUpdates>
    <screens>
        <name>Confirm_Screen</name>
        <label>Confirm</label>
        <locationX>176</locationX>
        <locationY>290</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Send_Envelope</targetReference>
        </connector>
        <fields>
            <name>confirmText</name>
            <fieldText>&lt;p&gt;You are about to send this contract for DocuSign signature to:&lt;/p&gt;&lt;p&gt;&lt;b&gt;{!Get_Contact.Name}&lt;/b&gt; &amp;lt;{!Get_Contact.Email}&amp;gt;&lt;/p&gt;&lt;p&gt;Click &lt;b&gt;Send&lt;/b&gt; to send the email and move the contract to &lt;b&gt;Awaiting Signature&lt;/b&gt;.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Send</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Result_Screen</name>
        <label>Result</label>
        <locationX>176</locationX>
        <locationY>770</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>resultDisplay</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Status:&lt;/b&gt; {!Send_Envelope.status}&lt;/p&gt;&lt;p&gt;&lt;b&gt;Envelope Id:&lt;/b&gt; {!Send_Envelope.envelopeId}&lt;/p&gt;&lt;p&gt;{!Send_Envelope.message}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contract</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
