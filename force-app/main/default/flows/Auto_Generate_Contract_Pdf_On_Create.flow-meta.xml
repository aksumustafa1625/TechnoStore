<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <actionCalls>
        <name>Generate_Pdf</name>
        <label>Generate Branded Contract PDF</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <actionName>GenerateContractPdfService</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>contractId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>GenerateContractPdfService</nameSegment>
    </actionCalls>
    <description>Record-triggered: regenerates the TechnoStore-branded MSA PDF whenever a Contract is created or its key fields (AccountId, StartDate, EndDate, ContractTerm) change. The service deletes the prior MSA PDF before inserting the new one, so the Contract always has a single up-to-date branded PDF. Status / DocuSign / approval transitions do NOT trigger regen because those fields aren't in the ISCHANGED list.</description>
    <interviewLabel>Auto Generate Contract PDF {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Auto Generate Contract PDF On Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Generate_Pdf</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>false</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
    NOT(ISBLANK({!$Record.AccountId})),
    NOT(ISBLANK({!$Record.StartDate})),
    NOT(ISBLANK({!$Record.EndDate})),
    OR(
        ISCHANGED({!$Record.AccountId}),
        ISCHANGED({!$Record.StartDate}),
        ISCHANGED({!$Record.EndDate}),
        ISCHANGED({!$Record.ContractTerm})
    )
)</filterFormula>
        <object>Contract</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
