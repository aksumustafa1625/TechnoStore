<apex:page renderAs="pdf" applyHtmlTag="true" applyBodyTag="false" showHeader="false" sidebar="false"
           standardStylesheets="false" controller="InvoicePdfController" cache="false">
<head>
    <title>Invoice Preview {!invoice.DocumentNumber}</title>
    <style type="text/css">
        @page { size: A4; margin: 0; }
        * { box-sizing: border-box; }
        html, body {
            margin: 0; padding: 0;
            font-family: 'Helvetica', 'Arial', sans-serif;
            color: #1F2937; font-size: 10pt; line-height: 1.5;
        }
        .page { width: 100%; }

        /* TOP RIBBON */
        .top-ribbon {
            height: 8pt;
            background-color: #FF6B35;
        }

        /* HEADER (white bg, contrast with ribbon) */
        .header {
            background-color: #FFFFFF;
            color: #1F2937;
            padding: 28pt 36pt 20pt 36pt;
            border-bottom: 1pt solid #E5E7EB;
        }
        .header-table { width: 100%; }
        .header-table td { vertical-align: middle; }
        .brand-logo {
            background-color: #1B4F72;
            color: #FFFFFF;
            font-size: 24pt;
            font-weight: 900;
            text-align: center;
            border-radius: 8pt;
            width: 50pt; height: 50pt;
        }
        .brand-text { padding-left: 14pt; }
        .brand-name {
            font-size: 22pt; font-weight: 700;
            line-height: 1.05; letter-spacing: -0.5pt;
            color: #1B4F72;
        }
        .brand-tagline {
            font-size: 7.5pt;
            color: #FF6B35;
            letter-spacing: 2.5pt;
            font-weight: 600;
            margin-top: 4pt;
        }
        .header-right { text-align: right; }
        .invoice-label {
            font-size: 9pt;
            color: #FF6B35;
            letter-spacing: 4pt;
            font-weight: 700;
        }
        .invoice-number {
            font-size: 22pt;
            font-weight: 700;
            margin-top: 4pt;
            letter-spacing: -0.5pt;
            color: #1B4F72;
        }
        .invoice-sub {
            font-size: 9pt;
            color: #6B7280;
            margin-top: 2pt;
            letter-spacing: 1pt;
        }

        /* AWAITING PAYMENT BANNER */
        .awaiting-banner {
            background-color: #FFF7ED;
            border-top: 1pt solid #FED7AA;
            border-bottom: 1pt solid #FED7AA;
            padding: 14pt 36pt;
        }
        .awaiting-banner-table { width: 100%; }
        .awaiting-icon-cell {
            background-color: #FF6B35;
            color: #FFFFFF;
            width: 36pt; height: 36pt;
            text-align: center;
            font-size: 18pt;
            font-weight: 900;
            border-radius: 18pt;
        }
        .awaiting-text-cell { padding-left: 14pt; vertical-align: middle; }
        .awaiting-title {
            font-size: 14pt;
            font-weight: 700;
            color: #9A3412;
        }
        .awaiting-sub {
            font-size: 9.5pt;
            color: #C2410C;
            margin-top: 2pt;
        }
        .awaiting-amount-cell {
            text-align: right;
            vertical-align: middle;
        }
        .awaiting-amount-label {
            font-size: 8pt;
            color: #9A3412;
            letter-spacing: 1.5pt;
            font-weight: 600;
        }
        .awaiting-amount {
            font-size: 22pt;
            font-weight: 700;
            color: #FF6B35;
            letter-spacing: -0.5pt;
        }

        /* BODY */
        .body-section { padding: 24pt 36pt 0 36pt; }

        .info-grid { width: 100%; margin-bottom: 22pt; }
        .info-grid > tbody > tr > td { vertical-align: top; padding: 0; }
        .info-grid .left-col { width: 50%; padding-right: 16pt; }
        .info-grid .right-col {
            width: 50%; padding-left: 24pt;
            border-left: 1pt solid #E5E7EB;
        }

        .section-label {
            font-size: 8pt;
            color: #FF6B35;
            letter-spacing: 2pt;
            font-weight: 700;
            margin-bottom: 8pt;
            text-transform: uppercase;
        }
        .company-name {
            font-size: 13pt; font-weight: 700;
            color: #1B4F72; margin-bottom: 4pt;
        }
        .contact-name {
            font-size: 9.5pt; color: #6B7280; margin-bottom: 6pt;
        }
        .address-line { color: #374151; margin-bottom: 1pt; font-size: 9.5pt; }
        .email-line {
            color: #1B4F72;
            margin-top: 6pt;
            font-size: 9pt;
        }

        .invoice-details-table { width: 100%; }
        .invoice-details-table td {
            padding: 4pt 0;
            font-size: 9.5pt;
        }
        .invoice-details-table td.label { color: #6B7280; width: 45%; }
        .invoice-details-table td.value {
            font-weight: 600; color: #1F2937; text-align: right;
        }

        .badge-pending {
            display: inline-block;
            padding: 4pt 12pt;
            border-radius: 14pt;
            font-size: 8pt;
            font-weight: 700;
            letter-spacing: 0.8pt;
            background-color: #FF6B35;
            color: #FFFFFF;
        }

        /* LINE ITEMS — minimalist */
        .items-section { padding: 0 36pt; margin-bottom: 18pt; }
        .items-table {
            width: 100%;
            border-collapse: collapse;
        }
        .items-table thead { background-color: #FFFFFF; }
        .items-table th {
            padding: 10pt 10pt;
            font-size: 7.5pt;
            text-align: left;
            color: #9A3412;
            font-weight: 700;
            letter-spacing: 1pt;
            text-transform: uppercase;
            border-bottom: 2pt solid #FF6B35;
        }
        .items-table th.num { text-align: right; }
        .items-table td {
            padding: 12pt 10pt;
            border-bottom: 1pt solid #F3F4F6;
            font-size: 9.5pt;
            color: #1F2937;
            vertical-align: top;
        }
        .items-table td.num { text-align: right; }
        .items-table td.product {
            font-weight: 600; color: #1B4F72;
        }
        .items-table td.period {
            font-size: 8.5pt; color: #6B7280;
        }
        .items-table td.line-total { font-weight: 700; color: #1F2937; }

        /* TOTALS */
        .totals-section { padding: 0 36pt; margin-bottom: 24pt; }
        .totals-wrap { width: 100%; }
        .totals-wrap > tbody > tr > td.spacer { width: 60%; }
        .totals-wrap > tbody > tr > td.totals-cell { vertical-align: top; }
        .totals-table { width: 100%; border-collapse: collapse; }
        .totals-table td { padding: 6pt 0; font-size: 10pt; }
        .totals-table td.label-cell {
            color: #6B7280; text-align: right; padding-right: 20pt;
        }
        .totals-table td.amount-cell {
            text-align: right; color: #1F2937; font-weight: 600;
        }
        .totals-table tr.total-row td {
            border-top: 2pt solid #FF6B35;
            padding-top: 10pt;
            font-size: 14pt;
            font-weight: 700;
            color: #FF6B35;
        }

        /* PAY NOW CTA BOX */
        .pay-cta-section {
            margin: 0 36pt 24pt 36pt;
            padding: 24pt 28pt;
            background-color: #1B4F72;
            border-radius: 6pt;
        }
        .pay-cta-table { width: 100%; }
        .pay-cta-table td { vertical-align: middle; }
        .cta-title {
            font-size: 14pt;
            font-weight: 700;
            color: #FFFFFF;
            margin-bottom: 4pt;
        }
        .cta-sub {
            font-size: 9.5pt;
            color: #B6C0D1;
            line-height: 1.4;
        }
        .cta-button-cell { text-align: right; }
        .cta-button {
            display: inline-block;
            background-color: #FF6B35;
            color: #FFFFFF;
            font-weight: 700;
            font-size: 11pt;
            padding: 12pt 24pt;
            border-radius: 6pt;
            text-decoration: none;
            letter-spacing: 0.5pt;
        }
        .cta-link-row {
            margin-top: 12pt;
            padding-top: 12pt;
            border-top: 1pt solid #2D5A82;
        }
        .cta-link-label {
            font-size: 8pt;
            color: #B6C0D1;
            letter-spacing: 1pt;
            font-weight: 600;
        }
        .cta-link-value {
            font-size: 8pt;
            color: #FFFFFF;
            word-break: break-all;
            margin-top: 4pt;
        }

        /* FOOTER */
        .footer {
            padding: 16pt 36pt 24pt 36pt;
            text-align: center;
            border-top: 1pt solid #E5E7EB;
            color: #6B7280;
            font-size: 7.5pt;
            line-height: 1.6;
        }
        .footer .footer-bold { color: #1B4F72; font-weight: 700; font-size: 8pt; }
        .footer .powered-by {
            margin-top: 6pt;
            color: #9CA3AF;
            letter-spacing: 1.5pt;
            font-size: 6.5pt;
            text-transform: uppercase;
        }
    </style>
</head>
<body>
    <div class="page">

        <!-- TOP ORANGE RIBBON -->
        <div class="top-ribbon"></div>

        <!-- WHITE HEADER -->
        <div class="header">
            <table class="header-table" cellspacing="0" cellpadding="0">
                <tr>
                    <td>
                        <table cellspacing="0" cellpadding="0"><tr>
                            <td class="brand-logo">TS</td>
                            <td class="brand-text">
                                <div class="brand-name">TechnoStore</div>
                                <div class="brand-tagline">PAYMENT REQUEST</div>
                            </td>
                        </tr></table>
                    </td>
                    <td class="header-right">
                        <div class="invoice-label">INVOICE</div>
                        <div class="invoice-number">{!invoice.DocumentNumber}</div>
                        <div class="invoice-sub">AWAITING PAYMENT</div>
                    </td>
                </tr>
            </table>
        </div>

        <!-- AWAITING PAYMENT BANNER -->
        <div class="awaiting-banner">
            <table class="awaiting-banner-table" cellspacing="0" cellpadding="0">
                <tr>
                    <td>
                        <table cellspacing="0" cellpadding="0"><tr>
                            <td class="awaiting-icon-cell">!</td>
                            <td class="awaiting-text-cell">
                                <div class="awaiting-title">Payment Required</div>
                                <div class="awaiting-sub">Please pay this invoice by {!dueDateStr} to avoid service interruption.</div>
                            </td>
                        </tr></table>
                    </td>
                    <td class="awaiting-amount-cell">
                        <div class="awaiting-amount-label">AMOUNT DUE</div>
                        <div class="awaiting-amount">{!totalFormatted}</div>
                    </td>
                </tr>
            </table>
        </div>

        <!-- BODY -->
        <div class="body-section">
            <table class="info-grid" cellspacing="0" cellpadding="0">
                <tr>
                    <td class="left-col">
                        <div class="section-label">BILL TO</div>
                        <div class="company-name">{!invoice.BillingAccount.Name}</div>
                        <div class="contact-name">{!invoice.BillToContact.Name}</div>
                        <apex:outputText escape="false" rendered="{!NOT(ISBLANK(invoice.BillingAccount.BillingStreet))}"><div class="address-line">{!invoice.BillingAccount.BillingStreet}</div></apex:outputText>
                        <div class="address-line">{!invoice.BillingAccount.BillingPostalCode} {!invoice.BillingAccount.BillingCity}</div>
                        <apex:outputText escape="false" rendered="{!NOT(ISBLANK(invoice.BillingAccount.BillingCountry))}"><div class="address-line">{!invoice.BillingAccount.BillingCountry}</div></apex:outputText>
                        <div class="email-line">{!invoice.BillToContact.Email}</div>
                    </td>
                    <td class="right-col">
                        <div class="section-label">INVOICE DETAILS</div>
                        <table class="invoice-details-table" cellspacing="0" cellpadding="0">
                            <tr><td class="label">Issue Date</td><td class="value">{!issueDate}</td></tr>
                            <tr><td class="label">Due Date</td><td class="value">{!dueDateStr}</td></tr>
                            <tr><td class="label">Reference</td><td class="value">{!invoice.DocumentNumber}</td></tr>
                            <tr><td class="label">Order Type</td><td class="value">{!fulfillmentLabel}</td></tr>
                            <tr><td class="label">Status</td>
                                <td class="value"><span class="badge-pending">AWAITING PAYMENT</span></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>

        <!-- LINE ITEMS -->
        <div class="items-section">
            <table class="items-table" cellspacing="0" cellpadding="0">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th class="num">Qty</th>
                        <th class="num">List Price</th>
                        <th class="num">Discount</th>
                        <th class="num">Net Price</th>
                        <th class="num">Tax</th>
                        <th class="num">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!lineWrappers}" var="lw">
                        <tr>
                            <td class="product">{!lw.productName}</td>
                            <td class="num">{!lw.quantityStr}</td>
                            <td class="num">{!lw.listPriceFormatted}</td>
                            <td class="num">{!lw.discountPercentStr}</td>
                            <td class="num">{!lw.netPriceFormatted}</td>
                            <td class="num">{!lw.taxFormatted}</td>
                            <td class="num line-total">{!lw.lineTotalFormatted}</td>
                        </tr>
                    </apex:repeat>
                </tbody>
            </table>
        </div>

        <!-- TOTALS -->
        <div class="totals-section">
            <table class="totals-wrap" cellspacing="0" cellpadding="0">
                <tr>
                    <td class="spacer"></td>
                    <td class="totals-cell">
                        <table class="totals-table" cellspacing="0" cellpadding="0">
                            <tr>
                                <td class="label-cell">Subtotal</td>
                                <td class="amount-cell">{!subtotalFormatted}</td>
                            </tr>
                            <tr>
                                <td class="label-cell">{!vatLabel}</td>
                                <td class="amount-cell">{!taxFormatted}</td>
                            </tr>
                            <tr class="total-row">
                                <td class="label-cell">AMOUNT DUE</td>
                                <td class="amount-cell">{!totalFormatted}</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>

        <!-- PAY NOW CTA -->
        <div class="pay-cta-section">
            <table class="pay-cta-table" cellspacing="0" cellpadding="0">
                <tr>
                    <td>
                        <div class="cta-title">Pay this invoice securely online</div>
                        <div class="cta-sub">Tap the button to complete payment via Stripe — bank-level encryption, instant confirmation.</div>
                    </td>
                    <td class="cta-button-cell">
                        <a class="cta-button" href="{!invoice.Stripe_Payment_URL__c}">PAY NOW &rarr;</a>
                    </td>
                </tr>
            </table>
            <div class="cta-link-row">
                <div class="cta-link-label">DIRECT PAYMENT LINK</div>
                <div class="cta-link-value">{!invoice.Stripe_Payment_URL__c}</div>
            </div>
        </div>

        <!-- FOOTER -->
        <div class="footer">
            <div class="footer-bold">TechnoStore GmbH</div>
            <div>Friedrichstraße 100 &middot; 10117 Berlin &middot; Germany</div>
            <div>support@technostore.com &middot; technostore.de &middot; VAT: DE123456789</div>
            <div class="powered-by">Powered by Salesforce Revenue Cloud &middot; Stripe &middot; MuleSoft &middot; Sendcloud</div>
        </div>

    </div>
</body>
</apex:page>
