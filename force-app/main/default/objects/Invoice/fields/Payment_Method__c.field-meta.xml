<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Method__c</fullName>
    <description>How this Invoice is being paid. Stripe = card / online checkout. SEPA = SEPA Direct Debit (DACH B2B standard). Bank_Transfer = Net 30 / Net 60 invoice + bank transfer reconciled via CAMT.053. Wire = international wire. Demo uses Stripe by default; SAP Payment Reconciliation (ADR-025) populates SEPA / Bank_Transfer when CAMT.053 reconciles match.</description>
    <label>Payment Method</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Stripe</fullName>
                <default>true</default>
                <label>Stripe (Card)</label>
            </value>
            <value>
                <fullName>SEPA</fullName>
                <default>false</default>
                <label>SEPA Direct Debit</label>
            </value>
            <value>
                <fullName>Bank_Transfer</fullName>
                <default>false</default>
                <label>Bank Transfer (Net 30-60)</label>
            </value>
            <value>
                <fullName>Wire</fullName>
                <default>false</default>
                <label>International Wire</label>
            </value>
            <value>
                <fullName>Other</fullName>
                <default>false</default>
                <label>Other</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
