# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# Mule project secrets (credentials must never be committed)
salesforce-jira-integration/src/main/resources/dev.yaml
salesforce-jira-integration/target/
salesforce-jira-integration/.mule/

# JIRA credentials setup script (contains real API token)
scripts/setup_jira_config.apex

# Notion credentials setup script (contains real integration token)
scripts/setup_notion_config.apex

# SAP API Hub credentials setup script (contains real API Key)
scripts/setup_sap_config.apex

# Email Config setup script (contains dev fallback mailbox)
scripts/setup_email_config.apex

# General pattern — any future setup_*_config.apex script that holds real
# credentials. Add a specific entry above when adding a new Custom Setting.
scripts/setup_*_config.apex

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# ==============================================
# Secrets & API credentials — NEVER commit these
# ==============================================
# MuleSoft properties (contain Stripe API key, Slack webhook, Sendcloud credentials)
**/mule-app.properties
**/mule-*.properties
**/application.properties
**/application-*.properties

# Generic secrets patterns
**/secrets.json
**/secrets.yaml
**/credentials.json
**/.credentials
**/*.pem
**/*.key
**/api-keys.txt

# MuleSoft project directories (if checked in alongside SF)
technostore-integration/
**/AnypointStudio/

# Stripe webhook signing secrets (whsec_*)
**/whsec_*

# JIRA API credentials (mulesoft/jira-properties.yaml has real token, never commit)
**/jira-properties.yaml
!**/jira-properties.yaml.template

# ngrok config
ngrok.yml
.ngrok2/

# Salesforce PRM auto-generated split files (Windows long path)
**/prm_winter24*
**/prm_channel_*

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/
interview-prep/

# ============================================================
# Salesforce CLI auth artifacts — NEVER commit (contain live access tokens)
# ============================================================
org_info.json
**/org_info.json
.tmp/
**/auth.txt
**/sfdx_auth.txt
**/sfdx-auth.txt
**/access_token.txt

# ============================================================
# Salesforce CLI cached output artifacts — local-only, often
# contain instance URLs and user IDs that should not be in repo
# ============================================================
# Schema describe caches
c_desc.txt
scl.json
scl_describe.txt
# Deploy output captures
scripts/dep.json
scripts/deploy_flow.json
scripts/deploy_result.json
scripts/deploy_errors.txt
# Ad-hoc local working files
cv_payload.json
docx_b64.txt
new_maps.json
