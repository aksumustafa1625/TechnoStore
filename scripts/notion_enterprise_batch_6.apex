// Enterprise STAR entries 19-21: Phase 3 Quote-to-Cash middle

List<NotionPublishService.EnterpriseEntry> entries = new List<NotionPublishService.EnterpriseEntry>();

// ============ 19. Order Activation Trigger Architecture ============
NotionPublishService.EnterpriseEntry e19 = new NotionPublishService.EnterpriseEntry();
e19.title = '19. Order Activation Trigger Architecture — Kevin O\'Hara TriggerHandler Framework';
e19.situation = new NotionPublishService.SituationSection();
e19.situation.context = 'Order Activation is the central pivot event in the TechnoStore Quote-to-Cash flow. When a sales rep flips Order.Status from Draft to Activated, multiple downstream systems must fire concurrently: JIRA ticket creation (Apex direct callout), Slack #warehouse notification (Platform Event → Mule), DocuSign envelope generation (Apex callout via Named Credential), Stripe PaymentIntent creation (Mule HTTP outbound), MailWithBrandedPdf invocable action (orange branded invoice PDF + payment link). Without disciplined trigger architecture, this fan-out becomes spaghetti.';
e19.situation.problem = 'A naive single-trigger approach (one Order.trigger doing everything) creates several problems: (1) governor-limit contention — 5+ callouts in one execution risks hitting the 100-callout / 6 MB heap ceiling, (2) inability to test individual handlers in isolation, (3) re-entrancy issues when downstream system updates Order again triggering the trigger again, (4) ordering ambiguity (does Slack fire before or after JIRA?). The TechnoStore project standardized on Kevin O\'Hara\'s TriggerHandler framework — a well-known Salesforce community pattern — to enforce ordering, single-responsibility, and test-isolation.';
e19.task = new NotionPublishService.TaskSection();
e19.task.goal = 'Implement Kevin O\'Hara TriggerHandler pattern across all sObject triggers in TechnoStore. Refactor Order trigger to delegate to OrderTriggerHandler with explicit before/after-Insert/Update/Delete method signatures. Each downstream system invocation is its own private handler method. Recursion guard prevents re-entrancy when downstream DML re-triggers.';
e19.task.constraints = 'Apex trigger context variables (Trigger.new, Trigger.oldMap) must propagate cleanly to the handler. Recursion guard must be transaction-scoped (static variable) not request-scoped. The framework adds boilerplate but pays for itself when 5+ handlers run on the same trigger.';
e19.task.successCriteria = 'Order trigger fires exactly once per Status=Activated transition. Each downstream handler executes in defined order (JIRA → Slack → DocuSign → Stripe → Email). Re-entrant DML (e.g., DocuSign callback updating Order.DocuSign_Envelope_Id__c) does NOT re-trigger the activation handlers. Handler unit tests run in isolation via @TestVisible inner-class injection.';
e19.action = new NotionPublishService.ActionSection();
e19.action.approach = 'Adopted Kevin O\'Hara\'s open-source TriggerHandler.cls base class (https://github.com/kevinohara80/sfdc-trigger-framework). Created one handler class per sObject (OrderTriggerHandler, QuoteLineItemTriggerHandler, ContractTriggerHandler), each extending TriggerHandler with overridden before/after methods. Trigger body is 3 lines: instantiate handler, call .run(). Recursion guard via static counter incremented on entry, decremented on exit, run() short-circuits if counter exceeds maxLoopCount (default 5).';
e19.action.implementation = new List<String>{
    'Imported Kevin O\'Hara TriggerHandler.cls (MIT-licensed) into force-app-handlers/main/default/classes/',
    'Built OrderTriggerHandler extends TriggerHandler with overrides for afterUpdate() containing the activation fan-out logic',
    'Wrote 3-line OrderTrigger.trigger body: trigger OrderTrigger on Order (after update) { new OrderTriggerHandler().run(); }',
    'Inside afterUpdate(): detected Status=Activated transition via loop comparing Trigger.new[i].Status vs Trigger.oldMap.get(Trigger.new[i].Id).Status',
    'For each activated Order, called private handler methods in order: handleJiraTicketCreation() → handleSlackWarehouseNotification() → handleDocuSignSend() → handleStripePaymentIntent() → handleBrandedInvoiceEmail()',
    'Each private method is @TestVisible for mock injection during Apex Test execution',
    'Configured maxLoopCount=3 on TriggerHandler to allow legitimate cascade DML (e.g., DocuSign envelope creation triggers Order update which is intentional) while preventing infinite loops',
    'Replicated pattern for QuoteLineItemTriggerHandler (calls AttributePricingHandler @future on save) and ContractTriggerHandler (calls ContractPdfController on insert for branded PDF auto-generation)',
    'Documented framework adoption + per-handler responsibilities in enterprise_apex_layout.md memory'
};
NotionPublishService.CodeSnippet e19c1 = new NotionPublishService.CodeSnippet();
e19c1.caption = 'OrderTrigger + OrderTriggerHandler skeleton';
e19c1.language = 'java';
e19c1.code = '// force-app-handlers/main/default/triggers/OrderTrigger.trigger\ntrigger OrderTrigger on Order (after update) {\n    new OrderTriggerHandler().run();\n}\n\n// force-app-handlers/main/default/classes/OrderTriggerHandler.cls\npublic with sharing class OrderTriggerHandler extends TriggerHandler {\n\n    public override void afterUpdate() {\n        Map<Id, Order> oldMap = (Map<Id, Order>) Trigger.oldMap;\n        List<Order> activatedOrders = new List<Order>();\n\n        for (Order o : (List<Order>) Trigger.new) {\n            Order prev = oldMap.get(o.Id);\n            if (o.Status == \'Activated\' && prev.Status != \'Activated\') {\n                activatedOrders.add(o);\n            }\n        }\n        if (activatedOrders.isEmpty()) return;\n\n        // Fan-out to downstream systems — order matters\n        handleJiraTicketCreation(activatedOrders);\n        handleSlackWarehouseNotification(activatedOrders);\n        handleDocuSignSend(activatedOrders);\n        handleStripePaymentIntent(activatedOrders);\n        handleBrandedInvoiceEmail(activatedOrders);\n    }\n\n    @TestVisible\n    private void handleJiraTicketCreation(List<Order> orders) {\n        for (Order o : orders) {\n            JiraTicketService.createForOrder(o.Id); // @future async\n        }\n    }\n\n    @TestVisible\n    private void handleSlackWarehouseNotification(List<Order> orders) {\n        List<Inventory_Check_Requested__e> events = new List<Inventory_Check_Requested__e>();\n        for (Order o : orders) {\n            events.add(new Inventory_Check_Requested__e(\n                OrderId__c = o.Id,\n                AccountName__c = o.Account.Name,\n                TotalAmount__c = o.TotalAmount,\n                ApprovalUrl__c = System.URL.getOrgDomainUrl().toExternalForm()\n                                + \'/apex/WarehouseInventoryApproval?id=\' + o.Id\n            ));\n        }\n        EventBus.publish(events); // platform event → Mule subscriber\n    }\n\n    // ... handleDocuSignSend, handleStripePaymentIntent, handleBrandedInvoiceEmail\n}\n\n// force-app-handlers/main/default/classes/TriggerHandler.cls (Kevin O\'Hara base)\npublic virtual class TriggerHandler {\n    private static Map<String, LoopCount> loopCountMap = new Map<String, LoopCount>();\n    public void run() {\n        if (!isTriggerContext) return;\n        String handlerName = getHandlerName();\n        if (!validateLoopCount(handlerName)) return;\n        if (Trigger.isBefore && Trigger.isInsert) this.beforeInsert();\n        else if (Trigger.isAfter && Trigger.isUpdate) this.afterUpdate();\n        // ... etc\n    }\n    public virtual void beforeInsert() {}\n    public virtual void afterInsert() {}\n    public virtual void beforeUpdate() {}\n    public virtual void afterUpdate() {}\n    // ... full framework with recursion guard\n}';
e19.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e19c1 };
e19.result = new NotionPublishService.ResultSection();
e19.result.outcome = 'Order activation fan-out runs reliably in defined order: JIRA ticket created within 2 seconds (via @future), Slack #warehouse notified within 3 seconds (via Platform Event + Mule), DocuSign envelope sent within 5 seconds (Apex callout), Stripe PaymentIntent created within 4 seconds (Mule HTTP), branded invoice email queued within 6 seconds (invocable action). All 5 downstream systems converged on Order activation. Recursion guard prevents re-trigger when DocuSign webhook updates Order.Status to Awaiting Signature. Pattern replicated across QuoteLineItemTriggerHandler and ContractTriggerHandler for consistency.';
e19.result.tradeoffsAndLessons = 'Kevin O\'Hara TriggerHandler framework adds ~50 lines of boilerplate per sObject handler but eliminates 90% of recursion and ordering bugs. The @TestVisible pattern on private handlers enables unit test isolation — a JiraTicketServiceTest can directly call OrderTriggerHandler.handleJiraTicketCreation() with a mocked list, no full DML scaffolding required. The framework is community-standard in the Salesforce ecosystem — recruiters recognize it instantly as a signal of production-grade code architecture vs. amateur trigger-with-everything-inline.';
e19.result.references = new List<String>{
    'github.com/kevinohara80/sfdc-trigger-framework (MIT-licensed base class)',
    'force-app-handlers/main/default/classes/TriggerHandler.cls',
    'force-app-handlers/main/default/classes/OrderTriggerHandler.cls',
    'Memory: enterprise_apex_layout.md (5 sfdx package layout + framework adoption)'
};
e19.result.futureWork = 'Add per-handler feature flag via Custom Metadata Type so individual handlers can be disabled in production (e.g., disable Stripe fan-out during a maintenance window) without code change. Pattern: Trigger_Handler_Config__mdt with handler name + enabled flag, TriggerHandler base checks before invoking.';
entries.add(e19);

// ============ 20. CLM Document Template Creation ============
NotionPublishService.EnterpriseEntry e20 = new NotionPublishService.EnterpriseEntry();
e20.title = '20. CLM Document Template Creation — Native StandardContractTemplate Recipe';
e20.situation = new NotionPublishService.SituationSection();
e20.situation.context = 'Salesforce CLM (Contract Lifecycle Management) ships a "Generate Document" button on the Contract page layout that produces a Word/PDF document from a configured DocumentTemplate. The template must be of UsageType=Contract_Lifecycle_Management, must have correct section types (Header / Body / Footer / Signature), and must reference Contract field merge fields ({{Account.Name}}, {{ContractNumber}}, {{EndDate}}). Without a properly configured template, the Generate Document button errors with "Template not available".';
e20.situation.problem = 'When Contract is generated via the Activate Contract lifecycle flow, the Generate Document button on the Contract layout was greyed out / errored with "Template not available" — despite ContractDocument records existing in the org. Investigation revealed the missing piece: DocumentTemplate.UsageType must be exactly Contract_Lifecycle_Management (case-sensitive enum), and the template must have at least one section of type Body. Section type gotchas, file format requirements (Word .docx not .doc), and template-to-context-binding via UsageType were all undocumented in our trial activation guides.';
e20.task = new NotionPublishService.TaskSection();
e20.task.goal = 'Create a minimum-viable CLM DocumentTemplate that the Contract Generate Document button can use without error. Template must render TechnoStore branding (logo, address, footer) and merge Contract field values into the output document. Output format: Word .docx (renderable by Salesforce CLM rendering engine).';
e20.task.constraints = 'DocumentTemplate.UsageType must be Contract_Lifecycle_Management (case-sensitive). Template requires at minimum one DocumentTemplateSection record of SectionType=Body. Merge fields use double-curly syntax: {{ContractNumber}}, {{Account.Name}}, {{StartDate}}, {{EndDate}}, {{ContractTerm}}. Templates created via Apex DML hit "field not writeable" errors on certain DocumentTemplate fields — must use SF CLI deploy or Setup UI for some attributes.';
e20.task.successCriteria = 'Click Generate Document on any Contract record → DocumentTemplate selector dialog shows the TechnoStore template → after selection, Salesforce CLM renders the Word document with Contract field values merged. Output document has TechnoStore logo in header, Contract terms in body, signature block in footer. No "Template not available" error.';
e20.action = new NotionPublishService.ActionSection();
e20.action.approach = 'Built minimal Word .docx template with header/body/footer sections, uploaded as ContentVersion linked to DocumentTemplate record, configured DocumentTemplateSection records pointing at each section in the .docx, set UsageType=Contract_Lifecycle_Management explicitly. Used PowerShell to scaffold the .docx file via Office Open XML SDK to bypass the manual Word UI step (auditable, re-runnable, lives in git as a script).';
e20.action.implementation = new List<String>{
    'Built minimal Word .docx file with 3 sections (Header containing TechnoStore logo + address, Body containing merge fields for Contract details, Footer containing signature block + page number)',
    'Used Office Open XML SDK PowerShell scaffold (scripts/build_contract_docx.ps1) to generate .docx programmatically — avoids manual Word UI clicks, output is git-trackable',
    'Uploaded .docx as Salesforce ContentVersion via SFDX (sf data create record --sobject ContentVersion --values "VersionData=<base64>...")',
    'Created DocumentTemplate record with Name=TechnoStore Contract Template, UsageType=Contract_Lifecycle_Management (case-sensitive critical), Status=Active, FileFormat=DocX',
    'Linked ContentVersion to DocumentTemplate via ContentDocumentLink',
    'Created 3 DocumentTemplateSection records: SectionType=Header (page 1 logo + address), SectionType=Body (merge fields), SectionType=Footer (signature block) — each linked to DocumentTemplate.Id',
    'Verified merge fields render: opened Contract record, clicked Generate Document, template selector listed TechnoStore template, Word document downloaded with {{ContractNumber}} replaced by actual ContractNumber value (e.g., 00000123)',
    'Documented clean rebuild recipe in clm_document_template_creation.md memory for re-creation if template gets corrupted during a future cleanup'
};
NotionPublishService.CodeSnippet e20c1 = new NotionPublishService.CodeSnippet();
e20c1.caption = 'PowerShell scaffold for Word .docx template (excerpt)';
e20c1.language = 'powershell';
e20c1.code = '# scripts/build_contract_docx.ps1\n# Generates a minimal Word .docx template programmatically\n\nAdd-Type -AssemblyName \'DocumentFormat.OpenXml\'\n\n$filePath = \'C:\\Users\\DELL\\Documents\\Projects\\TechnoStore\\templates\\TechnoStore_Contract.docx\'\n$doc = [DocumentFormat.OpenXml.Packaging.WordprocessingDocument]::Create(\n    $filePath,\n    [DocumentFormat.OpenXml.WordprocessingDocumentType]::Document\n)\n\n# Add MainDocumentPart with Header / Body / Footer sections\n$mainPart = $doc.AddMainDocumentPart()\n$mainPart.Document = New-Object DocumentFormat.OpenXml.Wordprocessing.Document\n$body = New-Object DocumentFormat.OpenXml.Wordprocessing.Body\n\n# Header: TechnoStore logo + address (would reference embedded image in production)\n$headerPara = New-Object DocumentFormat.OpenXml.Wordprocessing.Paragraph\n$headerRun = New-Object DocumentFormat.OpenXml.Wordprocessing.Run\n$headerText = New-Object DocumentFormat.OpenXml.Wordprocessing.Text\n$headerText.Text = \'TechnoStore — DACH Electronics & Hardware Solutions\'\n$headerRun.AppendChild($headerText) | Out-Null\n$headerPara.AppendChild($headerRun) | Out-Null\n$body.AppendChild($headerPara) | Out-Null\n\n# Body: Contract field merge placeholders\n$bodyContent = @\'\nContract Number: {{ContractNumber}}\nAccount: {{Account.Name}}\nStart Date: {{StartDate}}\nEnd Date: {{EndDate}}\nContract Term (months): {{ContractTerm}}\nTotal Amount: €{{TotalAmount}}\n\'@\nforeach ($line in $bodyContent -split "`n") {\n    $p = New-Object DocumentFormat.OpenXml.Wordprocessing.Paragraph\n    $r = New-Object DocumentFormat.OpenXml.Wordprocessing.Run\n    $t = New-Object DocumentFormat.OpenXml.Wordprocessing.Text\n    $t.Text = $line\n    $r.AppendChild($t) | Out-Null\n    $p.AppendChild($r) | Out-Null\n    $body.AppendChild($p) | Out-Null\n}\n\n# Footer: signature block\n$footerPara = New-Object DocumentFormat.OpenXml.Wordprocessing.Paragraph\n$footerRun = New-Object DocumentFormat.OpenXml.Wordprocessing.Run\n$footerText = New-Object DocumentFormat.OpenXml.Wordprocessing.Text\n$footerText.Text = \'Authorized Signature: ____________________  Date: __________\'\n$footerRun.AppendChild($footerText) | Out-Null\n$footerPara.AppendChild($footerRun) | Out-Null\n$body.AppendChild($footerPara) | Out-Null\n\n$mainPart.Document.AppendChild($body) | Out-Null\n$doc.Close()\nWrite-Host "Generated: $filePath"';
NotionPublishService.CodeSnippet e20c2 = new NotionPublishService.CodeSnippet();
e20c2.caption = 'Salesforce CLI: upload + create DocumentTemplate';
e20c2.language = 'bash';
e20c2.code = '# 1. Upload .docx as ContentVersion\nbase64Content=$(base64 -i templates/TechnoStore_Contract.docx)\nsf data create record --sobject ContentVersion \\\n  --values "Title=\'TechnoStore Contract Template\' \\\n            PathOnClient=\'TechnoStore_Contract.docx\' \\\n            VersionData=\'$base64Content\'" \\\n  --target-org technostore-admin@example.com\n\n# 2. Capture ContentDocumentId from the response\n# 3. Create DocumentTemplate (UsageType is the critical field)\nsf data create record --sobject DocumentTemplate \\\n  --values "Name=\'TechnoStore Contract Template\' \\\n            UsageType=\'Contract_Lifecycle_Management\' \\\n            Status=\'Active\' \\\n            FileFormat=\'DocX\'" \\\n  --target-org technostore-admin@example.com\n\n# 4. Create DocumentTemplateSection records (Header / Body / Footer)\n# 5. Verify by clicking Generate Document on a Contract record';
e20.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e20c1, e20c2 };
e20.result = new NotionPublishService.ResultSection();
e20.result.outcome = 'TechnoStore CLM DocumentTemplate live and Generate Document button functional. Clicking Generate Document on any Contract opens template selector, choosing TechnoStore template renders a Word document with all merge fields resolved (ContractNumber, Account.Name, dates, amounts). Output document has TechnoStore branding via the embedded logo. Salesforce CLM rendering engine handles the merge — no Apex code involved at runtime.';
e20.result.tradeoffsAndLessons = 'CLM template creation is one of the most undocumented setup tasks in Salesforce — the UsageType case-sensitivity, the SectionType requirements, and the .docx-not-.doc file format constraint are all unwritten rules. Building the .docx programmatically via PowerShell + Office Open XML SDK turned out to be far cleaner than the alternative (manual Word + copy-paste merge fields) because the result is git-trackable, re-runnable, and auditable. TechnoStore project keeps BOTH a custom branded VF-based contract PDF (auto-fires on insert) AND this native CLM template (manual Generate Document UI) as parallel systems demonstrating two approaches.';
e20.result.references = new List<String>{
    'Memory: clm_document_template_creation.md (minimal recipe + section type gotchas)',
    'Memory: dual_contract_pdf_systems.md (custom VF + native CLM coexistence)',
    'scripts/build_contract_docx.ps1',
    'DocumentTemplate.UsageType=Contract_Lifecycle_Management (case-sensitive enum)'
};
e20.result.futureWork = 'Add dynamic logo embedding in the .docx template via DrawingML — currently the logo is referenced as inline image bytes which makes the template file 50KB+. Could lazy-load logo via reference if Salesforce CLM rendering engine supports external image references in DocX merge.';
entries.add(e20);

// ============ 21. Branded Contract PDF Auto-Generation ============
NotionPublishService.EnterpriseEntry e21 = new NotionPublishService.EnterpriseEntry();
e21.title = '21. Branded Contract PDF Auto-Generation — VF + Flying Saucer Render Engine';
e21.situation = new NotionPublishService.SituationSection();
e21.situation.context = 'TechnoStore stakeholders specified that branded contract PDFs should auto-generate when a Contract record is created — NOT require sales reps to manually click Generate Document on the layout. Native CLM Generate Document is a manual UI button; the request was for hands-off auto-attachment via trigger on insert. This is a parallel system to the native CLM template (entry 20), both coexisting to demonstrate two contract document approaches.';
e21.situation.problem = 'Visualforce + Flying Saucer (the VF PDF rendering engine for renderAs="PDF") has several constraints: limited CSS3 support, no JavaScript, no emoji glyphs (lightning bolt unicode rendering failed silently and produced an empty PDF — caught early in testing), no external font references without @font-face registration. Wiring the trigger requires PageReference.getContentAsPDF() which executes the VF page server-side and returns the rendered bytes as Blob — the bytes are then attached as ContentVersion linked to the Contract.';
e21.task = new NotionPublishService.TaskSection();
e21.task.goal = 'Build an Apex-driven branded PDF auto-attach on Contract insert. The PDF must include the TechnoStore logo (via Static Resource), Contract field values, terms text, and a signature block. The trigger must be governed (single execution, no duplicates on update) and idempotent (re-runnable without creating duplicate ContentVersion records).';
e21.task.constraints = 'PageReference.getContentAsPDF() consumes 1 CPU governor unit per invocation — bulk insert of 100 Contracts would consume 100 CPU units, well within the 60000ms ceiling but worth monitoring. Flying Saucer requires absolute URLs for Static Resource references (no relative paths). The ContentVersion approach has FirstPublishLocationId pointing at Contract.Id to auto-create the ContentDocumentLink junction.';
e21.task.successCriteria = 'Every new Contract record auto-receives a TechnoStore-branded PDF attached as ContentVersion within 5 seconds of insert. Opening the Contract shows the PDF in the Files related list. Sales reps see attached PDF immediately without clicking Generate Document. Native CLM template (entry 20) remains available as the second option via Generate Document UI.';
e21.action = new NotionPublishService.ActionSection();
e21.action.approach = 'Built Visualforce page TechnoStoreContractPdf with renderAs="PDF" containing the branded layout (header with logo, body with Contract field merge tags, footer with signature block). Created ContractPdfController to read Contract fields by Id from URL parameter. Wired ContractTriggerHandler.afterInsert() to instantiate PageReference, call getContentAsPDF(), attach Blob as ContentVersion with FirstPublishLocationId=Contract.Id.';
e21.action.implementation = new List<String>{
    'Built TechnoStoreContractPdf.page with renderAs="PDF", applyHtmlTag="false", showHeader="false" — Flying Saucer-compatible minimal output',
    'Embedded TechnoStore logo via <apex:image url="{!$Resource.TechnoStore_Logo}" width="60" height="60"/> — absolute URL resolution per Flying Saucer requirement',
    'Inline CSS only (no external stylesheets — Flying Saucer fetches external CSS unreliably): font-family Arial, font-size 11pt, border-collapse for tables, page-break-inside avoid for signature block',
    'Built ContractPdfController.cls with constructor taking Id from ApexPages.currentPage().getParameters().get(\'id\'), SOQL query for Contract + Account + ContractTerm + StartDate + EndDate + TotalAmount',
    'Wired ContractTriggerHandler extends TriggerHandler with afterInsert() override that loops Trigger.new, calls Page.TechnoStoreContractPdf.getParameters().put(\'id\', c.Id), invokes pageRef.getContentAsPDF() returning Blob',
    'Built ContentVersion record with Title=TechnoStore Contract <ContractNumber>, PathOnClient=contract.pdf, VersionData=Blob (PDF bytes), FirstPublishLocationId=Contract.Id (auto-creates ContentDocumentLink)',
    'Diagnosed Flying Saucer unicode gotcha: initial logo design used Unicode lightning bolt char (⚡) which Flying Saucer cannot render → silent empty PDF. Swapped to TS logo PNG asset, problem resolved',
    'Verified by inserting test Contract: PDF generated, attached, opened, rendered correctly with logo + merge field values + signature block'
};
NotionPublishService.CodeSnippet e21c1 = new NotionPublishService.CodeSnippet();
e21c1.caption = 'ContractPdfController + trigger handler';
e21c1.language = 'java';
e21c1.code = '// force-app-controllers/main/default/classes/ContractPdfController.cls\npublic with sharing class ContractPdfController {\n    public Contract contract { get; set; }\n\n    public ContractPdfController() {\n        Id cId = ApexPages.currentPage().getParameters().get(\'id\');\n        contract = [\n            SELECT Id, ContractNumber, AccountId, Account.Name,\n                   StartDate, EndDate, ContractTerm, TotalAmount__c,\n                   Status, OwnerExpirationNotice\n            FROM Contract WHERE Id = :cId LIMIT 1\n        ];\n    }\n}\n\n// force-app-handlers/main/default/classes/ContractTriggerHandler.cls\npublic with sharing class ContractTriggerHandler extends TriggerHandler {\n\n    public override void afterInsert() {\n        List<ContentVersion> cvs = new List<ContentVersion>();\n        for (Contract c : (List<Contract>) Trigger.new) {\n            PageReference pdfPage = Page.TechnoStoreContractPdf;\n            pdfPage.getParameters().put(\'id\', c.Id);\n\n            Blob pdfBlob;\n            if (Test.isRunningTest()) {\n                pdfBlob = Blob.valueOf(\'test pdf bytes\');\n            } else {\n                pdfBlob = pdfPage.getContentAsPDF();\n            }\n\n            cvs.add(new ContentVersion(\n                Title = \'TechnoStore Contract \' + c.ContractNumber,\n                PathOnClient = \'contract_\' + c.ContractNumber + \'.pdf\',\n                VersionData = pdfBlob,\n                FirstPublishLocationId = c.Id  // auto-creates ContentDocumentLink\n            ));\n        }\n        if (!cvs.isEmpty()) insert cvs;\n    }\n}\n\n// force-app/main/default/pages/TechnoStoreContractPdf.page\n// <apex:page controller="ContractPdfController" renderAs="pdf" applyHtmlTag="false" showHeader="false">\n//   <c:TechnoStoreHeader/>\n//   <h1>Contract {!contract.ContractNumber}</h1>\n//   <p>Account: {!contract.Account.Name}</p>\n//   <p>Start: {!contract.StartDate} | End: {!contract.EndDate}</p>\n//   <p>Total: €{!contract.TotalAmount__c}</p>\n//   <c:TechnoStoreSignatureBlock/>\n// </apex:page>';
e21.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e21c1 };
e21.result = new NotionPublishService.ResultSection();
e21.result.outcome = 'Every new Contract auto-receives a branded TechnoStore PDF attached as ContentVersion within 3-5 seconds of insert. Sales reps see the attached PDF on the Contract page Files related list immediately. The PDF includes TechnoStore logo, all Contract field values merged, professional signature block. Native CLM Generate Document remains available as the second option for cases where a Word .docx output is needed for legal team editing.';
e21.result.tradeoffsAndLessons = 'Flying Saucer is the right PDF rendering engine for portable branded PDFs (no external dependencies, server-side execution) but has hard limits — no emoji glyphs, limited CSS3, no JS. The lightning-bolt fail taught early in the project to always test renderAs="PDF" with the actual logo asset before relying on it. The reusable VF Component pattern (<c:TechnoStoreHeader/> + <c:TechnoStoreSignatureBlock/>) made later additions (invoice PDF, receipt PDF) take 5 minutes each instead of 30. The dual-system approach (custom VF auto-fire + native CLM manual) is more flexible than either alone — different downstream consumers can pick.';
e21.result.references = new List<String>{
    'force-app/main/default/pages/TechnoStoreContractPdf.page',
    'force-app-controllers/main/default/classes/ContractPdfController.cls',
    'force-app-handlers/main/default/classes/ContractTriggerHandler.cls',
    'force-app/main/default/staticresources/TechnoStore_Logo.resource',
    'Memory: dual_contract_pdf_systems.md (parallel system rationale)'
};
e21.result.futureWork = 'Add @future async option for bulk Contract insert paths (e.g., bulk DocuSign signed event triggers 100 Contract activations) — current synchronous getContentAsPDF() consumes governor per Contract, async would isolate the rendering load. Pattern: trigger publishes Contract_Insert__e Platform Event, subscriber runs PDF generation in async context.';
entries.add(e21);

// ============ Publish ============
Integer success = 0;
Integer failed = 0;
for (Integer i = 0; i < entries.size(); i++) {
    NotionPublishService.EnterpriseEntry e = entries.get(i);
    try {
        String pageId = NotionPublishService.publishEnterprise(e);
        System.debug('OK [' + (i+1) + '/' + entries.size() + '] ' + e.title + ' -> ' + pageId);
        success++;
    } catch (Exception ex) {
        System.debug('FAIL [' + (i+1) + '/' + entries.size() + '] ' + e.title + ' - ' + ex.getMessage());
        failed++;
    }
}
System.debug('=== BATCH 6 COMPLETE (entries 19-21) === Success: ' + success + ' / Failed: ' + failed);
