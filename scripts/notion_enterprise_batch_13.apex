// Enterprise STAR entries 37-38: Mule Choice Router + Inventory VF Page

List<NotionPublishService.EnterpriseEntry> entries = new List<NotionPublishService.EnterpriseEntry>();

// ============ 37. MuleSoft Choice Router — Physical vs Digital Branching ============
NotionPublishService.EnterpriseEntry e37 = new NotionPublishService.EnterpriseEntry();
e37.title = '37. MuleSoft Choice Router — Physical vs Digital Product Branching';
e37.situation = new NotionPublishService.SituationSection();
e37.situation.context = 'TechnoStore catalog spans Physical products (Workstations, Peripherals, Cables) and Digital products (Software Licenses, SaaS subscriptions). Fulfillment paths differ fundamentally: Physical orders require Sendcloud parcel creation + DHL pickup + shipping notification email; Digital orders require license key generation + welcome email with download link. The demo narrative needs to show enterprise-grade routing — one Order pipeline producing the correct outputs per product mix.';
e37.situation.problem = 'A naive design would duplicate the entire post-payment flow per product type (one flow for Physical orders, separate flow for Digital orders) — leading to maintenance burden when the fan-out logic changes. The MuleSoft Choice router (similar to a switch-case) is the right primitive: single input flow → conditional branching based on Order.Product_Type__c → distinct downstream actions per branch. Choice scope evaluates expressions in order; first match wins. Mixed-mode Orders (both Physical and Digital lines) require parallel fan-out via Scatter-Gather rather than Choice.';
e37.task = new NotionPublishService.TaskSection();
e37.task.goal = 'Implement Mule Choice router in the post-payment fan-out flow that branches on Order.Product_Type__c field. When=Physical → Sendcloud v3 order create + shipping notification email. When=Digital → license key UUID generation + welcome email with download link. Otherwise → Slack alert to ops team for manual handling.';
e37.task.constraints = 'Order.Product_Type__c is a custom picklist field populated by post-Order-creation Apex trigger inspecting OrderItem.Product2.Family values. Choice router expressions use MEL/DataWeave expression syntax: #[payload.Product_Type__c == "Physical"]. Branches execute serially within Choice (first match short-circuits); for parallel execution use Scatter-Gather scope instead. Otherwise branch is required to handle unknown product types gracefully.';
e37.task.successCriteria = 'Order with Workstation Pro line items → Product_Type__c=Physical → Choice routes to Sendcloud v3 + shipping email branch. Order with Software License line items → Product_Type__c=Digital → Choice routes to license generation + welcome email branch. Mixed order (Workstation + License) → Product_Type__c=Mixed → Scatter-Gather fan-out fires BOTH branches in parallel. Unknown product type → Otherwise branch → Slack ops alert for manual triage.';
e37.action = new NotionPublishService.ActionSection();
e37.action.approach = 'Built mule-fulfillment-router.xml as the post-payment fan-out flow. Salesforce Order activation publishes Mule-bound event with Product_Type__c value. Choice scope evaluates payload.Product_Type__c against Physical / Digital / Mixed cases. Each branch is a flow-ref invocation to a dedicated sub-flow (sendcloud-create-order / license-key-generation / mixed-fanout-scatter-gather). Otherwise branch references slack-ops-alert sub-flow.';
e37.action.implementation = new List<String>{
    'Determined Product_Type__c logic on Salesforce side: Apex Order trigger inspects OrderItems → if ALL items have Product2.Family in (Workstations, Peripherals, Cables) → Product_Type__c=Physical; if ALL in (Software Licenses) → Digital; if mixed → Mixed',
    'Built Mule mule-fulfillment-router.xml with HTTP Listener consuming SF post-payment payload',
    'Choice scope structure: <choice> with 3 <when> elements (Physical, Digital, Mixed) + 1 <otherwise> element for unknown types',
    'when expression=\'#[payload.Product_Type__c == "Physical"]\' → flow-ref name="sendcloud-create-order-v3" + flow-ref name="send-shipping-notification-email"',
    'when expression=\'#[payload.Product_Type__c == "Digital"]\' → flow-ref name="generate-license-key" + flow-ref name="send-welcome-email-with-license"',
    'when expression=\'#[payload.Product_Type__c == "Mixed"]\' → scatter-gather scope with both Physical and Digital sub-flows running in parallel',
    'otherwise → flow-ref name="slack-ops-team-alert" with error message "Unknown Product_Type for Order: #[payload.OrderId]"',
    'License key generation sub-flow: DataWeave random UUID via Crypto::randomBytes + base64Encode → stores in SF Order.License_Key__c via Connector update',
    'Welcome email sub-flow: invokes SF SingleEmailMessage with HTML body containing license key + download URL (https://downloads.technostore.example/license/<license_key>)',
    'Tested all 4 paths via Postman mock payloads simulating each Product_Type__c value: Physical → Sendcloud + email fires, Digital → license generation + email fires, Mixed → both branches in parallel, unknown → Slack ops alert',
    'Verified end-to-end demo: created mixed Order in SF (1× Workstation + 1× Software License), activation triggered Mule fan-out, Sendcloud parcel created AND license email sent within 5 seconds (parallel execution confirmed via Scatter-Gather)',
    'Documented Choice vs Scatter-Gather decision in mulesoft_integration_setup.md memory'
};
NotionPublishService.CodeSnippet e37c1 = new NotionPublishService.CodeSnippet();
e37c1.caption = 'Mule Choice scope + Scatter-Gather for mixed orders';
e37c1.language = 'xml';
e37c1.code = '<flow name="post-payment-fulfillment-router">\n    <http:listener config-ref="HTTP_Listener_Config" path="/order/fulfill"/>\n\n    <choice doc:name="Route by Product Type">\n        <when expression=\'#[payload.Product_Type__c == "Physical"]\'>\n            <logger message="Routing Physical Order #[payload.OrderId]" level="INFO"/>\n            <flow-ref name="sendcloud-create-order-v3"/>\n            <flow-ref name="send-shipping-notification-email"/>\n        </when>\n\n        <when expression=\'#[payload.Product_Type__c == "Digital"]\'>\n            <logger message="Routing Digital Order #[payload.OrderId]" level="INFO"/>\n            <flow-ref name="generate-license-key"/>\n            <flow-ref name="send-welcome-email-with-license"/>\n        </when>\n\n        <when expression=\'#[payload.Product_Type__c == "Mixed"]\'>\n            <logger message="Routing Mixed Order #[payload.OrderId] — fan-out via Scatter-Gather" level="INFO"/>\n            <scatter-gather doc:name="Parallel Physical + Digital">\n                <route>\n                    <flow-ref name="sendcloud-create-order-v3"/>\n                    <flow-ref name="send-shipping-notification-email"/>\n                </route>\n                <route>\n                    <flow-ref name="generate-license-key"/>\n                    <flow-ref name="send-welcome-email-with-license"/>\n                </route>\n            </scatter-gather>\n        </when>\n\n        <otherwise>\n            <logger message="Unknown Product_Type for Order #[payload.OrderId]" level="WARN"/>\n            <flow-ref name="slack-ops-team-alert"/>\n        </otherwise>\n    </choice>\n</flow>\n\n<flow name="generate-license-key">\n    <ee:transform>\n        <ee:variables>\n            <ee:set-variable variableName="licenseKey"><![CDATA[%dw 2.0\noutput application/java\nimport dw::Crypto\n---\n("TS-" ++ (Crypto::randomBytes(8) as String {base: "base64"} replace /[+/=]/ with "")) as String]]></ee:set-variable>\n        </ee:variables>\n    </ee:transform>\n\n    <!-- Persist generated license key on SF Order record -->\n    <sfdc:update objectType="Order" config-ref="Salesforce_Config">\n        <sfdc:records>#[{\n            "Id": payload.OrderId,\n            "License_Key__c": vars.licenseKey\n        }]</sfdc:records>\n    </sfdc:update>\n</flow>';
e37.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e37c1 };
e37.result = new NotionPublishService.ResultSection();
e37.result.outcome = 'One Order activation → routed correctly per product mix via Mule Choice + Scatter-Gather. Physical orders ship via Sendcloud within 5 seconds. Digital orders get license email within 5 seconds. Mixed orders trigger both branches in parallel (Scatter-Gather guarantees parallel execution, total elapsed = max(branch_durations) not sum). Unknown product types alert ops team via Slack rather than failing silently. Single fan-out flow handles 4 distinct cases without duplication.';
e37.result.tradeoffsAndLessons = 'Choice router is the right primitive for sequential conditional branching (when one branch is the right answer per case). Scatter-Gather is the right primitive for parallel fan-out (when multiple branches must all run per case, like Mixed orders). The two scopes compose cleanly: Choice on outer level, Scatter-Gather inside the Mixed when-branch. Demo narrative captures this nuance — recruiters see the engineer understands the distinction between routing decisions (one path) and fan-out decisions (parallel paths).';
e37.result.references = new List<String>{
    'src/main/mule/flows/post-payment-fulfillment-router.xml',
    'src/main/mule/flows/generate-license-key.xml',
    'MuleSoft Choice + Scatter-Gather scope documentation',
    'Order.Product_Type__c custom picklist (Apex trigger populates from OrderItem.Product2.Family)'
};
e37.result.futureWork = 'Add Subscription-product handling: when Product2.Family = Subscription, route to Stripe Subscriptions API (recurring billing) instead of one-shot PaymentIntent. Currently all products treated as one-shot; subscription tier is the natural next demo expansion.';
entries.add(e37);

// ============ 38. Inventory Approval — Custom Visualforce Page ============
NotionPublishService.EnterpriseEntry e38 = new NotionPublishService.EnterpriseEntry();
e38.title = '38. Inventory Approval — Custom Visualforce Approval Page with Separation of Duties';
e38.situation = new NotionPublishService.SituationSection();
e38.situation.context = 'After Order activation triggers Slack #warehouse notification (entry 36), the warehouse user clicks the deep-link button in Slack and lands on a custom VF page (/apex/WarehouseInventoryApproval?id=<orderId>). This page is the warehouse-team decision surface: shows Order details + line items + stock-availability checkboxes + Mark In Stock / Mark Out of Stock buttons. The page enforces separation-of-duties: Sales activates Order (one role); Operations marks stock (different role + different surface).';
e38.situation.problem = 'The original Order page layout had "Mark In Stock" and "Mark Out of Stock" buttons directly — meaning the sales rep who activated the Order could also mark stock outcome on the SAME page, violating separation of duties. SOX-compliant enterprise patterns require these decisions to come from distinct roles via distinct surfaces. Solution: build a dedicated VF page surfacing only stock-related decisions, accessible via Slack deep link, restricted to warehouse-team profile. Remove Mark In/Out Stock buttons from the standard Order layout.';
e38.task = new NotionPublishService.TaskSection();
e38.task.goal = 'Build WarehouseInventoryApproval Visualforce page that (a) takes Order Id from URL parameter, (b) displays Order details + line items, (c) provides Mark In Stock / Mark Out of Stock buttons that update Order.Inventory_Status__c, (d) is accessible only to warehouse-team profile via permission set. Remove the existing Mark In/Out Stock buttons from Order page layout.';
e38.task.constraints = 'VF page must be ApexPages controller-driven (not standard controller — needs Apex methods for button actions). Order Id from URL parameter requires ApexPages.currentPage().getParameters().get(\'id\'). Page must not allow editing of Order fields other than Inventory_Status__c (FLS enforcement via with sharing controller). Profile restriction via Setup → Visualforce Pages → WarehouseInventoryApproval → Security → only Warehouse_Team profile + System Admin can access.';
e38.task.successCriteria = 'Warehouse user clicks Slack button → /apex/WarehouseInventoryApproval?id=<orderId> opens in browser → page renders TechnoStore-branded header + Order summary (Account + Total + Line Items) + Mark In Stock / Mark Out of Stock buttons. Clicking Mark In Stock → Order.Inventory_Status__c = "In Stock", page shows confirmation. Mark Out of Stock → Inventory_Status__c = "Out of Stock", confirmation. Sales rep cannot access this page (profile restriction); Sales rep on Order layout sees Inventory_Status__c as read-only field reflecting warehouse decision.';
e38.action = new NotionPublishService.ActionSection();
e38.action.approach = 'Built WarehouseInventoryApprovalController.cls with constructor reading Id from URL, SOQL for Order + OrderItems, public action methods markInStock() + markOutOfStock() performing DML update. Built WarehouseInventoryApproval.page with apex:page controller binding, apex:pageBlock for layout, apex:commandButton wired to action methods. Created Warehouse_Team profile cloned from Custom Profile, granted only Inventory_Status__c FLS + Order Read + WarehouseInventoryApproval page access. Removed Mark In/Out Stock buttons from Order page layout.';
e38.action.implementation = new List<String>{
    'Built WarehouseInventoryApprovalController.cls with public Order order field, constructor: Id oId = ApexPages.currentPage().getParameters().get(\'id\'); order = [SELECT Id, OrderNumber, TotalAmount, Inventory_Status__c, Account.Name, (SELECT Product2.Name, Quantity FROM OrderItems) FROM Order WHERE Id = :oId LIMIT 1]',
    'Built WarehouseInventoryApproval.page with apex:page controller="WarehouseInventoryApprovalController", apex:pageBlock for Order details, apex:pageBlockTable for line items, apex:commandButton action="{!markInStock}" + action="{!markOutOfStock}"',
    'Implemented markInStock() action: update new Order(Id = order.Id, Inventory_Status__c = \'In Stock\', Inventory_Approved_By__c = UserInfo.getUserId(), Inventory_Approved_At__c = System.now()); return null (stays on same page, refreshes view)',
    'Implemented markOutOfStock() action: update new Order(Id = order.Id, Inventory_Status__c = \'Out of Stock\', ...); return null',
    'Created Warehouse_Team profile cloned from Custom Profile (read-only base): granted Order object Read permission only + Inventory_Status__c field Edit FLS only + WarehouseInventoryApproval VF page access',
    'Created Warehouse_Inventory_Approval permission set with same grants — assignable to specific users without changing their profile',
    'Removed Mark In Stock + Mark Out of Stock buttons from Order page layout via Setup → Object Manager → Order → Page Layouts → removed from Buttons section + removed from platformActionList',
    'Made Order.Inventory_Status__c read-only on Order layout for non-warehouse users — sales reps see the status reflecting warehouse decision but cannot edit it',
    'Tested end-to-end: warehouse user clicks Slack deep link → /apex/WarehouseInventoryApproval?id=<orderId> opens → user reviews → clicks Mark In Stock → Order.Inventory_Status__c flips to In Stock with audit trail (Inventory_Approved_By + Inventory_Approved_At)',
    'Verified separation of duties: tested with Sales profile user → tried to navigate to VF page URL directly → got "Insufficient Privileges" error (profile lacks page access)',
    'Documented separation-of-duties pattern in inventory_approval_warehouse_flow.md memory'
};
NotionPublishService.CodeSnippet e38c1 = new NotionPublishService.CodeSnippet();
e38c1.caption = 'WarehouseInventoryApprovalController + VF page';
e38c1.language = 'java';
e38c1.code = '// force-app-controllers/main/default/classes/WarehouseInventoryApprovalController.cls\npublic with sharing class WarehouseInventoryApprovalController {\n\n    public Order order { get; set; }\n    public String confirmationMessage { get; set; }\n\n    public WarehouseInventoryApprovalController() {\n        Id oId = ApexPages.currentPage().getParameters().get(\'id\');\n        loadOrder(oId);\n    }\n\n    private void loadOrder(Id oId) {\n        order = [\n            SELECT Id, OrderNumber, TotalAmount, Inventory_Status__c,\n                   Inventory_Approved_By__r.Name, Inventory_Approved_At__c,\n                   Account.Name,\n                   (SELECT Id, Product2.Name, Quantity, UnitPrice FROM OrderItems)\n            FROM Order\n            WHERE Id = :oId\n            LIMIT 1\n        ];\n    }\n\n    public PageReference markInStock() {\n        updateInventoryStatus(\'In Stock\');\n        confirmationMessage = \'Order \' + order.OrderNumber + \' marked as IN STOCK by \'\n                             + UserInfo.getName() + \' at \' + System.now().format();\n        return null; // stay on page, refresh view\n    }\n\n    public PageReference markOutOfStock() {\n        updateInventoryStatus(\'Out of Stock\');\n        confirmationMessage = \'Order \' + order.OrderNumber + \' marked as OUT OF STOCK by \'\n                             + UserInfo.getName() + \' at \' + System.now().format();\n        return null;\n    }\n\n    private void updateInventoryStatus(String newStatus) {\n        update new Order(\n            Id = order.Id,\n            Inventory_Status__c = newStatus,\n            Inventory_Approved_By__c = UserInfo.getUserId(),\n            Inventory_Approved_At__c = System.now()\n        );\n        loadOrder(order.Id); // refresh order in memory\n    }\n}\n\n// force-app/main/default/pages/WarehouseInventoryApproval.page\n/*\n<apex:page controller="WarehouseInventoryApprovalController" tabStyle="Order">\n    <c:TechnoStoreHeader/>\n    <apex:form>\n        <apex:pageBlock title="Warehouse Inventory Approval">\n            <apex:pageMessages />\n            <apex:outputText value="{!confirmationMessage}" rendered="{!NOT(ISBLANK(confirmationMessage))}"\n                style="color:#28A745; font-weight:bold;"/>\n\n            <apex:pageBlockSection title="Order Details" columns="2">\n                <apex:outputField value="{!order.OrderNumber}"/>\n                <apex:outputField value="{!order.Account.Name}"/>\n                <apex:outputField value="{!order.TotalAmount}"/>\n                <apex:outputField value="{!order.Inventory_Status__c}"/>\n            </apex:pageBlockSection>\n\n            <apex:pageBlockTable value="{!order.OrderItems}" var="oi">\n                <apex:column value="{!oi.Product2.Name}" headerValue="Product"/>\n                <apex:column value="{!oi.Quantity}" headerValue="Qty"/>\n                <apex:column value="{!oi.UnitPrice}" headerValue="Unit Price"/>\n            </apex:pageBlockTable>\n\n            <apex:pageBlockButtons location="bottom">\n                <apex:commandButton value="Mark In Stock" action="{!markInStock}"\n                    style="background:#28A745; color:white;"/>\n                <apex:commandButton value="Mark Out of Stock" action="{!markOutOfStock}"\n                    style="background:#DC3545; color:white;"/>\n            </apex:pageBlockButtons>\n        </apex:pageBlock>\n    </apex:form>\n</apex:page>\n*/';
e38.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e38c1 };
e38.result = new NotionPublishService.ResultSection();
e38.result.outcome = 'Warehouse user clicks Slack #warehouse deep link → custom VF approval page opens with Order details + Mark In/Out Stock buttons → decision recorded with full audit trail (Inventory_Approved_By + Inventory_Approved_At). Sales rep on Order page sees Inventory_Status__c as read-only field. SOX-compliant separation of duties architecturally enforced — not just by policy, by the UI surface boundary. Warehouse team workflow is independent of Sales team workflow, sharing only the Order record as the source of truth.';
e38.result.tradeoffsAndLessons = 'Separation of duties is more credible when enforced architecturally than when enforced by training. The "Sales rep COULD mark stock but is asked not to" pattern fails — the "Sales rep CANNOT access the marking surface" pattern succeeds. Custom Visualforce remains a strong tool for purpose-built UIs that need tight control: smaller surface than Lightning Page, faster to develop than LWC for static workflow screens, accessible from external systems via simple URL. The audit-trail fields (Approved_By + Approved_At) are critical for compliance reviews — without them the workflow is auditable but not provable.';
e38.result.references = new List<String>{
    'force-app/main/default/pages/WarehouseInventoryApproval.page',
    'force-app-controllers/main/default/classes/WarehouseInventoryApprovalController.cls',
    'Warehouse_Team profile + Warehouse_Inventory_Approval permission set',
    'Memory: inventory_approval_warehouse_flow.md (full pipeline + SoD rationale)'
};
e38.result.futureWork = 'Add partial-stock handling: instead of binary In/Out Stock, allow per-line-item stock decisions (Mark Line 1 In Stock, Mark Line 2 Backordered). Requires extending the VF page to render per-line buttons and OrderItem.Stock_Status__c field. Currently the demo treats all lines in an Order as one approval decision.';
entries.add(e38);

// ============ Publish ============
Integer success = 0;
Integer failed = 0;
for (Integer i = 0; i < entries.size(); i++) {
    NotionPublishService.EnterpriseEntry e = entries.get(i);
    try {
        String pageId = NotionPublishService.publishEnterprise(e);
        System.debug('OK [' + (i+1) + '/' + entries.size() + '] ' + e.title + ' -> ' + pageId);
        success++;
    } catch (Exception ex) {
        System.debug('FAIL [' + (i+1) + '/' + entries.size() + '] ' + e.title + ' - ' + ex.getMessage());
        failed++;
    }
}
System.debug('=== BATCH 13 COMPLETE (entries 37-38) === Success: ' + success + ' / Failed: ' + failed);
