// Enterprise STAR entries 39-40: JIRA tickets + JIRA Agile sprint management

List<NotionPublishService.EnterpriseEntry> entries = new List<NotionPublishService.EnterpriseEntry>();

// ============ 39. JIRA Ticket Auto-Creation — Apex Direct Callout ============
NotionPublishService.EnterpriseEntry e39 = new NotionPublishService.EnterpriseEntry();
e39.title = '39. JIRA Ticket Auto-Creation — Apex Direct Callout via Custom Setting';
e39.situation = new NotionPublishService.SituationSection();
e39.situation.context = 'When Order activates, TechnoStore\'s fulfillment team needs a JIRA ticket in project TS to track the delivery lifecycle (pick → pack → ship → deliver). JIRA Cloud REST API at /rest/api/3/issue accepts POST with Atlassian Document Format (ADF) description body + Basic Auth (email + API token). The original integration plan targeted MuleSoft Code Builder for the JIRA path — failed catastrophically over 8 hours (entry 26). Pivot decision: direct Apex callout instead, since this is a single-system one-shot operation that does not benefit from Mule orchestration.';
e39.situation.problem = 'JIRA Cloud REST API has specific schema requirements that surprise developers familiar with older JIRA Server: description field must be ADF (Atlassian Document Format — nested JSON with content / paragraph / text node types), NOT plain text or markdown. Issue type and priority are objects with name field, not strings directly. Project key must match exactly (case-sensitive). Authentication is HTTP Basic with email as username + API token as password (NOT the Atlassian account password — must generate API token at id.atlassian.com/manage-profile/security/api-tokens).';
e39.task = new NotionPublishService.TaskSection();
e39.task.goal = 'Build Apex trigger handler that fires on Order Status=Activated transition, calls JIRA Cloud /rest/api/3/issue endpoint to create a Task issue in project TS, captures returned issue key (e.g., TS-1), stores on Order.Jira_Ticket__c custom field for traceability. Use Custom Setting for credentials, @future for async execution.';
e39.task.constraints = 'JIRA Cloud /rest/api/3/issue POST endpoint requires ADF format for description (nested JSON with content/paragraph/text nodes). Auth via HTTP Basic with email + API token (NOT account password). Apex callout from trigger context must use @future(callout=true) to avoid synchronous callout-in-trigger restriction. Custom Setting Jira_Config__c (Protected Hierarchy) stores Base_URL, Auth_Token (base64-encoded email:token), Project_Key — gitignored setup script populates real values, never committed.';
e39.task.successCriteria = 'Order Status flips to Activated → OrderTriggerHandler.afterUpdate() detects transition → calls JiraTicketService.createForOrder(orderId) @future method → JIRA REST API returns 201 Created with issue key → Apex parses key and updates Order.Jira_Ticket__c = "TS-1". Total elapsed time: 2-3 seconds. Order page shows the JIRA ticket key as a clickable link.';
e39.action = new NotionPublishService.ActionSection();
e39.action.approach = 'Built JiraTicketService.cls with @future(callout=true) static method createForOrder(Id orderId). Reads Jira_Config__c protected Custom Setting for Base_URL + Auth_Token + Project_Key. Constructs JIRA issue payload with fields.project.key, fields.summary, fields.description as ADF, fields.issuetype.name=Task, fields.priority.name=Medium. POST to <baseUrl>/rest/api/3/issue with Authorization: Basic <auth_token>. Parses 201 response, extracts issue key, updates Order.Jira_Ticket__c. Wired from OrderTriggerHandler.afterUpdate() activation handler (entry 19).';
e39.action.implementation = new List<String>{
    'Generated JIRA Cloud API token at id.atlassian.com/manage-profile/security/api-tokens — captured 24-character token string',
    'Computed Auth_Token: base64-encoded "email@example.com:<token>" string — stored in Jira_Config__c.Auth_Token__c',
    'Created Jira_Config__c Protected Hierarchy Custom Setting with fields: Base_URL__c (https://yourorg.atlassian.net), Auth_Token__c (base64), Project_Key__c (TS), Default_Issue_Type__c (Task), Default_Priority__c (Medium)',
    'Built scripts/setup_jira_config.apex (gitignored) to populate Jira_Config__c with real credentials — script lives in repo but is gitignored via .gitignore pattern scripts/setup_jira_config.apex',
    'Built JiraTicketService.cls with @future(callout=true) static method — async execution off the trigger context',
    'Method queries Order details: Id, OrderNumber, TotalAmount, Account.Name, BillToContact.Email',
    'Constructs JIRA issue payload with ADF-formatted description (nested JSON content array containing paragraph text nodes)',
    'fields.project = {key: cfg.Project_Key__c}, fields.summary = "TS Fulfillment — " + Order.OrderNumber, fields.issuetype = {name: "Task"}, fields.priority = {name: "Medium"}',
    'HTTP POST to cfg.Base_URL__c + "/rest/api/3/issue" with Authorization: "Basic " + cfg.Auth_Token__c and Content-Type: application/json',
    'On 201 Created response: parse JSON body, extract "key" field (e.g., "TS-1"), update Order via DML: update new Order(Id = orderId, Jira_Ticket__c = key)',
    'Wired from OrderTriggerHandler.afterUpdate() within the Order activation fan-out (entry 19)',
    'First successful ticket auto-created on Order 00000120 / Dickenson plc → TS-1 visible in JIRA within 2 seconds, Order.Jira_Ticket__c populated with "TS-1"',
    'Pipeline production-ready: every Order activation auto-creates a JIRA ticket reliably. MuleSoft path abandoned per architectural decision (entry 46)'
};
NotionPublishService.CodeSnippet e39c1 = new NotionPublishService.CodeSnippet();
e39c1.caption = 'JiraTicketService.cls — @future Apex callout';
e39c1.language = 'java';
e39c1.code = 'public with sharing class JiraTicketService {\n\n    @future(callout=true)\n    public static void createForOrder(Id orderId) {\n        Jira_Config__c cfg = Jira_Config__c.getOrgDefaults();\n        if (cfg == null || String.isBlank(cfg.Auth_Token__c)) {\n            throw new JiraServiceException(\'Jira_Config__c missing Auth_Token__c\');\n        }\n\n        Order o = [\n            SELECT Id, OrderNumber, TotalAmount, Account.Name,\n                   BillToContact.Email, BillToContact.Name\n            FROM Order WHERE Id = :orderId LIMIT 1\n        ];\n\n        // Build ADF (Atlassian Document Format) description\n        Map<String, Object> adfDescription = new Map<String, Object>{\n            \'type\' => \'doc\',\n            \'version\' => 1,\n            \'content\' => new List<Object>{\n                buildAdfParagraph(\'Customer: \' + o.Account.Name),\n                buildAdfParagraph(\'Contact: \' + o.BillToContact.Name + \' (\' + o.BillToContact.Email + \')\'),\n                buildAdfParagraph(\'Total Amount: €\' + o.TotalAmount),\n                buildAdfParagraph(\'Salesforce Order: \' + o.OrderNumber)\n            }\n        };\n\n        Map<String, Object> issue = new Map<String, Object>{\n            \'fields\' => new Map<String, Object>{\n                \'project\' => new Map<String, String>{ \'key\' => cfg.Project_Key__c },\n                \'summary\' => \'TS Fulfillment — Order \' + o.OrderNumber,\n                \'description\' => adfDescription,\n                \'issuetype\' => new Map<String, String>{ \'name\' => cfg.Default_Issue_Type__c },\n                \'priority\' => new Map<String, String>{ \'name\' => cfg.Default_Priority__c }\n            }\n        };\n\n        HttpRequest req = new HttpRequest();\n        req.setEndpoint(cfg.Base_URL__c + \'/rest/api/3/issue\');\n        req.setMethod(\'POST\');\n        req.setHeader(\'Authorization\', \'Basic \' + cfg.Auth_Token__c);\n        req.setHeader(\'Content-Type\', \'application/json\');\n        req.setHeader(\'Accept\', \'application/json\');\n        req.setBody(JSON.serialize(issue));\n        req.setTimeout(60000);\n\n        HttpResponse resp = new Http().send(req);\n        if (resp.getStatusCode() != 201) {\n            throw new JiraServiceException(\'JIRA HTTP \' + resp.getStatusCode() + \': \' + resp.getBody());\n        }\n        Map<String, Object> parsed = (Map<String, Object>) JSON.deserializeUntyped(resp.getBody());\n        String issueKey = (String) parsed.get(\'key\');\n\n        update new Order(Id = orderId, Jira_Ticket__c = issueKey);\n        System.debug(\'JIRA ticket created: \' + issueKey);\n    }\n\n    private static Map<String, Object> buildAdfParagraph(String text) {\n        return new Map<String, Object>{\n            \'type\' => \'paragraph\',\n            \'content\' => new List<Object>{\n                new Map<String, Object>{\n                    \'type\' => \'text\',\n                    \'text\' => text\n                }\n            }\n        };\n    }\n\n    public class JiraServiceException extends Exception {}\n}';
e39.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e39c1 };
e39.result = new NotionPublishService.ResultSection();
e39.result.outcome = 'First auto-created ticket TS-1 from Order 00000120 / Dickenson plc within 2 seconds of Order activation. Subsequent Orders create TS-2, TS-3 etc. JIRA project TS shows full backlog of TechnoStore fulfillment work. Order.Jira_Ticket__c custom field surfaces the issue key as a clickable hyperlink on the Order page (formatted via Lightning App Builder URL formula). Pipeline production-ready; MuleSoft path abandoned per the Mule-vs-Apex architectural decision (entry 46).';
e39.result.tradeoffsAndLessons = 'Direct Apex callout is the right tool for single-system one-shot integrations like JIRA ticket creation. The MuleSoft path was 8+ hours of failure (entry 26) for a use case that took 2 hours via Apex. The ADF format is the JIRA-specific gotcha — newcomers expecting markdown or plain text waste hours; reading the JIRA Cloud REST API docs upfront saves debugging time. Custom Setting Protected Hierarchy is the right credentials-storage primitive for Apex callouts (vs Named Credential which is heavier weight for a single integration).';
e39.result.references = new List<String>{
    'force-app-services/main/default/classes/JiraTicketService.cls',
    'force-app/main/default/objects/Jira_Config__c/ (Protected Hierarchy Custom Setting)',
    'scripts/setup_jira_config.apex (gitignored — real credentials)',
    'JIRA Cloud REST API v3 /rest/api/3/issue documentation',
    'Atlassian Document Format (ADF) specification'
};
e39.result.futureWork = 'Add bidirectional integration: JIRA Webhook → Salesforce Site → Platform Event → Apex trigger updates Order.Jira_Status__c when JIRA issue transitions (e.g., In Progress → Done). Currently one-way (Salesforce → JIRA); bidirectional would close the loop on fulfillment status visibility.';
entries.add(e39);

// ============ 40. JIRA Agile Sprint Management ============
NotionPublishService.EnterpriseEntry e40 = new NotionPublishService.EnterpriseEntry();
e40.title = '40. JIRA Agile Sprint Management — Sprint Provisioning + Ticket Assignment via Agile API';
e40.situation = new NotionPublishService.SituationSection();
e40.situation.context = 'After JIRA ticket auto-creation was working (entry 39), TS-1 was just sitting in the backlog without sprint structure. Real-world agile workflows require sprint provisioning, ticket assignment to active sprint, story-point estimation, and assignee management. JIRA Cloud has TWO REST API namespaces: /rest/api/3/* (general issue CRUD) and /rest/agile/1.0/* (Scrum/Kanban features). Sprint and board operations live on the Agile API, not the general one.';
e40.situation.problem = 'JIRA Cloud Agile API custom field IDs are instance-specific — the Story Points field is customfield_10016 on most Cloud instances but can vary. Sprint creation requires a board ID (boards are owned by JIRA projects but separately identified). The /rest/agile/1.0/sprint POST creates a sprint with name + startDate + endDate + originBoardId. Adding tickets to a sprint uses POST /rest/agile/1.0/sprint/{id}/issue with body containing issues array. All operations require the same Basic Auth as the general API (entry 39).';
e40.task = new NotionPublishService.TaskSection();
e40.task.goal = 'Build sprint provisioning + ticket assignment script using JIRA Agile API. Create sprint "TS Sprint May 10-24" on board ID 34 (the TS project board). Add 9 tickets to sprint (TS-1 fulfillment ticket + 8 SAP integration tickets TS-2 through TS-9). Set story points totaling 17. Result: working sprint backlog ready for daily standups.';
e40.task.constraints = 'JIRA Cloud Agile API endpoints: POST /rest/agile/1.0/sprint creates sprint, POST /rest/agile/1.0/sprint/{id}/issue adds tickets to sprint, PUT /rest/agile/1.0/sprint/{id}/issue moves between sprints. Story points custom field ID: customfield_10016 on the TechnoStore JIRA instance (verified via GET /rest/api/3/field which lists all fields with their IDs). Board ID 34 captured from JIRA URL when viewing the TS project board.';
e40.task.successCriteria = 'Sprint "TS Sprint May 10-24" created on board 34 with sprint ID returned. 9 tickets added to sprint. Story points populated on each ticket totaling 17 SP. Sprint visible in JIRA Backlog → Active Sprints. Sprint dashboard renders correctly with 9 tickets grouped by status. Ready for daily standups and sprint demo.';
e40.action = new NotionPublishService.ActionSection();
e40.action.approach = 'Built JiraSprintService.cls with createSprint(name, startDate, endDate, boardId) + addIssuesToSprint(sprintId, issueKeys) + setStoryPoints(issueKey, points) methods. All callouts use Jira_Config__c credentials. Probed customfield_10016 ID via GET /rest/api/3/field (one-time setup). Captured board ID 34 from JIRA URL: /jira/software/c/projects/TS/boards/34. Created 8 SAP integration tickets (TS-2 through TS-9) manually via JIRA UI for sprint planning, then ran the script to bundle them with TS-1 into the sprint.';
e40.action.implementation = new List<String>{
    'Probed JIRA Cloud field IDs via GET /rest/api/3/field — returned full list of standard + custom fields; located Story Points at customfield_10016',
    'Captured TS project board ID 34 from JIRA URL when viewing the TS project Scrum board',
    'Built JiraSprintService.cls with createSprint(name, startDate, endDate, boardId) method: POST /rest/agile/1.0/sprint with body {name, startDate, endDate, originBoardId: 34}',
    'Returned sprint ID parsed from response — captured sprint ID 68 for "TS Sprint May 10-24"',
    'Built addIssuesToSprint(sprintId, issueKeys) method: POST /rest/agile/1.0/sprint/{id}/issue with body {issues: ["TS-1", "TS-2", ...]} — accepts array of issue keys',
    'Built setStoryPoints(issueKey, points) method: PUT /rest/api/3/issue/{key} with body {fields: {customfield_10016: <points>}} — story points field set on each issue',
    'Manually created 8 SAP integration tickets via JIRA UI for sprint planning: TS-2 SAP API Hub sandbox setup (3 SP), TS-3 SAP OData adapter (3 SP), TS-4 IDoc mapping (2 SP), TS-5 SAP outbound to Mule (2 SP), TS-6 SAP order replication (3 SP), TS-7 SAP material master sync (2 SP), TS-8 SAP error handling (1 SP), TS-9 SAP demo recording (1 SP) — total 17 SP plus 0 SP for TS-1 fulfillment placeholder',
    'Ran provisioning script: scripts/setup_jira_sprint.apex — created sprint id 68, added 9 tickets, set story points, transitioned sprint to Active state via POST /rest/agile/1.0/sprint/{id} with {state: "active"}',
    'Verified in JIRA UI: Backlog → TS project → Active Sprints shows "TS Sprint May 10-24" with 9 tickets, 17 SP total, sprint dashboard rendering correctly',
    'Documented Agile API endpoints + customfield_10016 mapping in jira-sprint-setup memory section',
    'Tomorrow start TS-2 (SAP API Hub sandbox setup) per the sprint plan — demo narrative includes the sprint kickoff as live agile workflow'
};
NotionPublishService.CodeSnippet e40c1 = new NotionPublishService.CodeSnippet();
e40c1.caption = 'JiraSprintService.cls — Agile API sprint provisioning';
e40c1.language = 'java';
e40c1.code = 'public with sharing class JiraSprintService {\n\n    private static final Integer STORY_POINTS_FIELD_ID = 10016; // customfield_10016\n\n    public static Integer createSprint(String name, String startIso, String endIso, Integer boardId) {\n        Jira_Config__c cfg = Jira_Config__c.getOrgDefaults();\n\n        Map<String, Object> body = new Map<String, Object>{\n            \'name\' => name,\n            \'startDate\' => startIso,    // e.g., \'2026-05-10T09:00:00.000Z\'\n            \'endDate\' => endIso,        // e.g., \'2026-05-24T17:00:00.000Z\'\n            \'originBoardId\' => boardId  // e.g., 34\n        };\n\n        HttpRequest req = new HttpRequest();\n        req.setEndpoint(cfg.Base_URL__c + \'/rest/agile/1.0/sprint\');\n        req.setMethod(\'POST\');\n        req.setHeader(\'Authorization\', \'Basic \' + cfg.Auth_Token__c);\n        req.setHeader(\'Content-Type\', \'application/json\');\n        req.setBody(JSON.serialize(body));\n\n        HttpResponse resp = new Http().send(req);\n        if (resp.getStatusCode() != 201) {\n            throw new JiraSprintException(\'JIRA sprint create HTTP \' + resp.getStatusCode());\n        }\n        Map<String, Object> parsed = (Map<String, Object>) JSON.deserializeUntyped(resp.getBody());\n        return (Integer) parsed.get(\'id\');\n    }\n\n    public static void addIssuesToSprint(Integer sprintId, List<String> issueKeys) {\n        Jira_Config__c cfg = Jira_Config__c.getOrgDefaults();\n\n        HttpRequest req = new HttpRequest();\n        req.setEndpoint(cfg.Base_URL__c + \'/rest/agile/1.0/sprint/\' + sprintId + \'/issue\');\n        req.setMethod(\'POST\');\n        req.setHeader(\'Authorization\', \'Basic \' + cfg.Auth_Token__c);\n        req.setHeader(\'Content-Type\', \'application/json\');\n        req.setBody(JSON.serialize(new Map<String, Object>{ \'issues\' => issueKeys }));\n\n        HttpResponse resp = new Http().send(req);\n        if (resp.getStatusCode() != 204) {\n            throw new JiraSprintException(\'JIRA add issues HTTP \' + resp.getStatusCode());\n        }\n    }\n\n    public static void setStoryPoints(String issueKey, Decimal points) {\n        Jira_Config__c cfg = Jira_Config__c.getOrgDefaults();\n\n        Map<String, Object> body = new Map<String, Object>{\n            \'fields\' => new Map<String, Object>{\n                \'customfield_\' + STORY_POINTS_FIELD_ID => points\n            }\n        };\n\n        HttpRequest req = new HttpRequest();\n        req.setEndpoint(cfg.Base_URL__c + \'/rest/api/3/issue/\' + issueKey);\n        req.setMethod(\'PUT\');\n        req.setHeader(\'Authorization\', \'Basic \' + cfg.Auth_Token__c);\n        req.setHeader(\'Content-Type\', \'application/json\');\n        req.setBody(JSON.serialize(body));\n\n        new Http().send(req);\n    }\n\n    public class JiraSprintException extends Exception {}\n}\n\n// scripts/setup_jira_sprint.apex — invocation\nInteger sprintId = JiraSprintService.createSprint(\n    \'TS Sprint May 10-24\',\n    \'2026-05-10T09:00:00.000Z\',\n    \'2026-05-24T17:00:00.000Z\',\n    34\n);\nSystem.debug(\'Created sprint id: \' + sprintId);\n\nJiraSprintService.addIssuesToSprint(sprintId,\n    new List<String>{ \'TS-1\',\'TS-2\',\'TS-3\',\'TS-4\',\'TS-5\',\'TS-6\',\'TS-7\',\'TS-8\',\'TS-9\' }\n);\n\nMap<String, Decimal> spByKey = new Map<String, Decimal>{\n    \'TS-2\' => 3, \'TS-3\' => 3, \'TS-4\' => 2, \'TS-5\' => 2,\n    \'TS-6\' => 3, \'TS-7\' => 2, \'TS-8\' => 1, \'TS-9\' => 1\n};\nfor (String key : spByKey.keySet()) JiraSprintService.setStoryPoints(key, spByKey.get(key));';
e40.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e40c1 };
e40.result = new NotionPublishService.ResultSection();
e40.result.outcome = 'Sprint id 68 "TS Sprint May 10-24" live in JIRA TS project with 9 tickets totaling 17 story points (TS-1 fulfillment + 8 SAP integration tickets TS-2 through TS-9). Sprint dashboard renders in JIRA showing burndown chart + ticket status columns. Demo narrative includes the sprint kickoff as live agile workflow — recruiters see end-to-end Salesforce → JIRA → Sprint planning integration. Tomorrow\'s development work (2026-05-12) starts with TS-2 SAP API Hub sandbox setup per the sprint plan.';
e40.result.tradeoffsAndLessons = 'JIRA Cloud has two REST API namespaces (/rest/api/3/* general, /rest/agile/1.0/* sprint/board features). New developers often look only at the general namespace and miss the Agile features — worth flagging clearly. Story points custom field ID varies per JIRA instance (customfield_10016 on most Cloud, can differ on Server installs); probing via GET /rest/api/3/field once and caching the ID in code is the pragmatic approach. Sprint planning workflow demonstrates the value of API-driven setup over UI clicking — 9 tickets + story points + sprint creation took 30 seconds via script vs. 5 minutes via UI.';
e40.result.references = new List<String>{
    'force-app-services/main/default/classes/JiraSprintService.cls',
    'scripts/setup_jira_sprint.apex',
    'JIRA Cloud Agile API documentation (/rest/agile/1.0/*)',
    'customfield_10016 = Story Points on TechnoStore JIRA instance',
    'TS project board ID 34'
};
e40.result.futureWork = 'Automate sprint creation on a recurring schedule (every 2 weeks) via Apex Scheduled job — currently manual script invocation. Add sprint retrospective ticket auto-creation at sprint end. Wire sprint completion event to Salesforce dashboard via JIRA webhook → SF Platform Event.';
entries.add(e40);

// ============ Publish ============
Integer success = 0;
Integer failed = 0;
for (Integer i = 0; i < entries.size(); i++) {
    NotionPublishService.EnterpriseEntry e = entries.get(i);
    try {
        String pageId = NotionPublishService.publishEnterprise(e);
        System.debug('OK [' + (i+1) + '/' + entries.size() + '] ' + e.title + ' -> ' + pageId);
        success++;
    } catch (Exception ex) {
        System.debug('FAIL [' + (i+1) + '/' + entries.size() + '] ' + e.title + ' - ' + ex.getMessage());
        failed++;
    }
}
System.debug('=== BATCH 14 COMPLETE (entries 39-40) === Success: ' + success + ' / Failed: ' + failed);
