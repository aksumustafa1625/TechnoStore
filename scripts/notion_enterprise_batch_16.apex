// Enterprise STAR entries 43-44: TriggerHandler framework + Enterprise Apex layout

List<NotionPublishService.EnterpriseEntry> entries = new List<NotionPublishService.EnterpriseEntry>();

// ============ 43. Apex Code Organization â€” Kevin O'Hara TriggerHandler Framework ============
NotionPublishService.EnterpriseEntry e43 = new NotionPublishService.EnterpriseEntry();
e43.title = '43. Apex Code Organization â€” Kevin O\'Hara TriggerHandler Framework Adoption';
e43.situation = new NotionPublishService.SituationSection();
e43.situation.context = 'Salesforce trigger anti-patterns are well-known in the community: one giant trigger.cls with hundreds of lines mixing all sObject lifecycle events, no recursion guard, no test-isolation, no ordering discipline. As TechnoStore grew to 3+ sObject triggers (Order, QuoteLineItem, Contract) each with multiple downstream system invocations (JIRA, Slack, DocuSign, Stripe, AttributePricing), the need for a disciplined trigger architecture became acute. Kevin O\'Hara\'s sfdc-trigger-framework (MIT-licensed, github.com/kevinohara80/sfdc-trigger-framework) is the de-facto community standard.';
e43.situation.problem = 'Without a structured trigger framework, common problems compound: (1) recursion â€” DML inside trigger handler updates the same record, retriggering the trigger infinitely; (2) ordering ambiguity â€” when 5+ handlers run on the same trigger, which runs first is undefined; (3) test-isolation difficulty â€” handler logic embedded directly in trigger body cannot be unit-tested without a full DML scaffold; (4) bypass flexibility â€” emergency disable of one handler (e.g., during data migration) requires code deployment instead of a config flag.';
e43.task = new NotionPublishService.TaskSection();
e43.task.goal = 'Adopt Kevin O\'Hara\'s TriggerHandler base class as the project standard. Refactor all existing sObject triggers (Order, QuoteLineItem, Contract) to delegate to handler classes extending the base. Each trigger body becomes 3 lines (instantiate handler + .run()). Handler classes contain the business logic with explicit before/after-Insert/Update/Delete method overrides + private @TestVisible helpers for unit-test injection.';
e43.task.constraints = 'TriggerHandler base class must be public virtual with .run() method dispatching to overridable before*/after* methods based on Trigger.operationType. Recursion guard is a static Map<String, LoopCount> tracking invocations per handler name, short-circuiting if loop count exceeds maxLoopCount (default 5). Bypass mechanism: TriggerHandler.bypass(\'OrderTriggerHandler\') static method temporarily disables a handler â€” useful during bulk data migrations.';
e43.task.successCriteria = 'All 3 trigger classes (OrderTrigger, QuoteLineItemTrigger, ContractTrigger) reduced to 3-line bodies delegating to handler classes. Each handler class extends TriggerHandler with explicit before/after method overrides containing business logic. @TestVisible private helpers enable unit-test invocation without full DML scaffolding. Recursion guard prevents re-entry on cascade DML. TriggerHandler.bypass() works to disable handlers during data migration. Demo of all 3 working in concert: Order activation fires OrderTriggerHandler â†’ JIRA + Slack + DocuSign + Stripe + email fan-out, recursion-safe.';
e43.action = new NotionPublishService.ActionSection();
e43.action.approach = 'Imported Kevin O\'Hara\'s TriggerHandler.cls (MIT license â€” copyright preserved in source header) into force-app-handlers/main/default/classes/. Refactored existing inline-trigger logic into handler classes: OrderTriggerHandler, QuoteLineItemTriggerHandler, ContractTriggerHandler. Each handler extends TriggerHandler base, overrides relevant before/after methods. Trigger bodies reduced to single .run() invocation. Set maxLoopCount=3 to allow legitimate cascade DML (e.g., DocuSign webhook updates Order which is intentional) while preventing infinite loops.';
e43.action.implementation = new List<String>{
    'Imported TriggerHandler.cls (Kevin O\'Hara MIT-licensed) into force-app-handlers/main/default/classes/ â€” public virtual base class with .run() dispatcher',
    'TriggerHandler.run() dispatches to before*/after* methods based on Trigger.operationType (BEFORE_INSERT, AFTER_UPDATE, etc) via switch statement',
    'Recursion guard via static Map<String, LoopCount> tracking invocations per handler name + maxLoopCount per handler (default 5)',
    'Bypass mechanism: TriggerHandler.bypass(\'OrderTriggerHandler\') marks a handler name in a static Set bypassedHandlers, run() short-circuits if name is in set',
    'Refactored OrderTrigger.trigger from 80-line inline logic to 3 lines: trigger OrderTrigger on Order (before insert, before update, after insert, after update) { new OrderTriggerHandler().run(); }',
    'Built OrderTriggerHandler extends TriggerHandler with afterUpdate() override containing the activation fan-out (entry 19) calling private @TestVisible handlers per downstream system',
    'Refactored QuoteLineItemTrigger.trigger similarly: 3 lines delegating to QuoteLineItemTriggerHandler which calls AttributePricingHandler.recalcAttributePricing() async (entry 14)',
    'Refactored ContractTrigger.trigger similarly: ContractTriggerHandler.afterInsert() contains the branded PDF auto-generation logic (entry 21)',
    'Set per-handler maxLoopCount=3: allows legitimate cascade (e.g., DocuSign webhook â†’ Contract.Status update â†’ Contract trigger fires AGAIN to re-render PDF if needed) but prevents infinite loops',
    'Added @TestVisible annotation to all private handler methods â€” enables unit test classes to call OrderTriggerHandler.handleJiraTicketCreation() directly with mock List<Order> input, no full DML scaffolding required',
    'Tested unit tests: built OrderTriggerHandlerTest with @TestVisible injection, asserted JIRA handler fires once on Status=Activated transition + zero times on other transitions',
    'Verified recursion guard in practice: DocuSign webhook â†’ Contract.Status=Signed â†’ ContractTrigger fires â†’ handler runs once, recursion counter increments to 1, next invocation in same transaction would short-circuit at counter=4',
    'Tested bypass: ran data-migration script with TriggerHandler.bypass(\'OrderTriggerHandler\') at start â†’ 50 Order inserts completed without JIRA/Slack/DocuSign fan-out fire (intentional during bulk migration)',
    'Documented framework adoption in enterprise_apex_layout.md memory'
};
NotionPublishService.CodeSnippet e43c1 = new NotionPublishService.CodeSnippet();
e43c1.caption = 'TriggerHandler base class + Order trigger refactor';
e43c1.language = 'java';
e43c1.code = '// force-app-handlers/main/default/classes/TriggerHandler.cls (Kevin O\'Hara, MIT)\npublic virtual class TriggerHandler {\n\n    private static Map<String, LoopCount> loopCountMap = new Map<String, LoopCount>();\n    private static Set<String> bypassedHandlers = new Set<String>();\n\n    public void run() {\n        if (!validateRun()) return;\n        addToLoopCount();\n\n        if (Trigger.isBefore && Trigger.isInsert) this.beforeInsert();\n        else if (Trigger.isBefore && Trigger.isUpdate) this.beforeUpdate();\n        else if (Trigger.isBefore && Trigger.isDelete) this.beforeDelete();\n        else if (Trigger.isAfter && Trigger.isInsert)  this.afterInsert();\n        else if (Trigger.isAfter && Trigger.isUpdate)  this.afterUpdate();\n        else if (Trigger.isAfter && Trigger.isDelete)  this.afterDelete();\n        else if (Trigger.isAfter && Trigger.isUndelete) this.afterUndelete();\n    }\n\n    public virtual void beforeInsert() {}\n    public virtual void afterInsert() {}\n    public virtual void beforeUpdate() {}\n    public virtual void afterUpdate() {}\n    public virtual void beforeDelete() {}\n    public virtual void afterDelete() {}\n    public virtual void afterUndelete() {}\n\n    public static void bypass(String handlerName) { bypassedHandlers.add(handlerName); }\n    public static void clearBypass(String handlerName) { bypassedHandlers.remove(handlerName); }\n\n    private Boolean validateRun() {\n        if (!Trigger.isExecuting) return false;\n        String handlerName = getHandlerName();\n        if (bypassedHandlers.contains(handlerName)) return false;\n        LoopCount lc = loopCountMap.get(handlerName);\n        if (lc != null && lc.exceeded()) return false;\n        return true;\n    }\n\n    private void addToLoopCount() {\n        String handlerName = getHandlerName();\n        if (!loopCountMap.containsKey(handlerName)) {\n            loopCountMap.put(handlerName, new LoopCount(3));\n        }\n        loopCountMap.get(handlerName).increment();\n    }\n\n    private String getHandlerName() { return String.valueOf(this).substring(0, String.valueOf(this).indexOf(\':\')); }\n\n    public class LoopCount {\n        private Integer max;\n        private Integer count = 0;\n        public LoopCount(Integer max) { this.max = max; }\n        public void increment() { count++; }\n        public Boolean exceeded() { return count >= max; }\n    }\n}\n\n// force-app/main/default/triggers/OrderTrigger.trigger\ntrigger OrderTrigger on Order (before insert, before update, after insert, after update) {\n    new OrderTriggerHandler().run();\n}\n\n// force-app-handlers/main/default/classes/OrderTriggerHandler.cls\npublic with sharing class OrderTriggerHandler extends TriggerHandler {\n\n    public override void afterUpdate() {\n        Map<Id, Order> oldMap = (Map<Id, Order>) Trigger.oldMap;\n        List<Order> activatedOrders = new List<Order>();\n\n        for (Order o : (List<Order>) Trigger.new) {\n            Order prev = oldMap.get(o.Id);\n            if (o.Status == \'Activated\' && prev.Status != \'Activated\') {\n                activatedOrders.add(o);\n            }\n        }\n        if (activatedOrders.isEmpty()) return;\n\n        // Fan-out â€” order matters, each handler is @TestVisible for unit-test injection\n        handleJiraTicketCreation(activatedOrders);\n        handleSlackWarehouseNotification(activatedOrders);\n        handleDocuSignSend(activatedOrders);\n        handleStripePaymentIntent(activatedOrders);\n        handleBrandedInvoiceEmail(activatedOrders);\n    }\n\n    @TestVisible private void handleJiraTicketCreation(List<Order> orders) {\n        for (Order o : orders) JiraTicketService.createForOrder(o.Id);\n    }\n\n    @TestVisible private void handleSlackWarehouseNotification(List<Order> orders) {\n        List<Inventory_Check_Requested__e> events = new List<Inventory_Check_Requested__e>();\n        for (Order o : orders) {\n            events.add(new Inventory_Check_Requested__e(\n                OrderId__c = o.Id, AccountName__c = o.Account.Name, TotalAmount__c = o.TotalAmount\n            ));\n        }\n        EventBus.publish(events);\n    }\n    // ... handleDocuSignSend, handleStripePaymentIntent, handleBrandedInvoiceEmail\n}';
e43.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e43c1 };
e43.result = new NotionPublishService.ResultSection();
e43.result.outcome = 'All 3 sObject triggers (Order, QuoteLineItem, Contract) refactored to 3-line bodies delegating to handler classes extending TriggerHandler. Recursion guard prevents infinite loops (cascade DML limited to depth 3). @TestVisible pattern enables direct unit-test invocation of private handlers â€” OrderTriggerHandlerTest exercises JIRA + Slack + DocuSign + Stripe + Email handlers in isolation with mocked Order data, no full SF DML scaffolding. Bypass mechanism allows safe bulk data migrations. Demo recording shows enterprise-grade trigger discipline.';
e43.result.tradeoffsAndLessons = 'Kevin O\'Hara TriggerHandler adds ~50 lines of boilerplate per handler class but eliminates 90% of recursion and ordering bugs encountered in naive trigger implementations. The community-standard pattern is instantly recognizable to recruiters as production-grade Salesforce architecture. The @TestVisible pattern is the canonical way to enable unit-test isolation without exposing private methods in production API. The bypass mechanism\'s value is hard to appreciate until you need it â€” emergency disable during a 50K-row migration is a real production scenario.';
e43.result.references = new List<String>{
    'github.com/kevinohara80/sfdc-trigger-framework (MIT-licensed source)',
    'force-app-handlers/main/default/classes/TriggerHandler.cls',
    'force-app-handlers/main/default/classes/OrderTriggerHandler.cls',
    'force-app-handlers/main/default/classes/QuoteLineItemTriggerHandler.cls',
    'force-app-handlers/main/default/classes/ContractTriggerHandler.cls',
    'Memory: enterprise_apex_layout.md (framework adoption + file structure)'
};
e43.result.futureWork = 'Add per-handler feature flag via Custom Metadata Type: Trigger_Handler_Config__mdt with handler_name + enabled flag â€” TriggerHandler base checks before invoking each handler. Enables config-driven enable/disable in production without code deployment. Pattern complements the existing bypass mechanism (which is session-scoped) with persistent enable/disable state.';
entries.add(e43);

// ============ 44. Enterprise Apex Layout â€” 5 sfdx Package Directories ============
NotionPublishService.EnterpriseEntry e44 = new NotionPublishService.EnterpriseEntry();
e44.title = '44. Enterprise Apex Layout â€” 5 sfdx Package Directories for Separation of Concerns';
e44.situation = new NotionPublishService.SituationSection();
e44.situation.context = 'A monolithic force-app/main/default/classes/ directory containing 50+ Apex classes becomes unmanageable as the project grows â€” controllers, services, handlers, triggers, tests all mixed in one folder. The Salesforce DX project structure supports multiple sfdx package directories declared in sfdx-project.json, each with its own force-app subfolder. This enables physical separation of concerns: controllers in one directory, services in another, etc. Familiar to engineers from Spring Boot multi-module projects or Maven multi-project builds.';
e44.situation.problem = 'Without structural separation, three antipatterns emerge: (1) circular dependencies â€” Controller calls Service calls another Controller; (2) test files mixed with production code making test-coverage queries noisy; (3) third-party imports (like Kevin O\'Hara TriggerHandler) mixed with TechnoStore-specific code making MIT license attribution unclear. The sfdx multi-package layout solves all three: clear directory ownership signals architectural layer.';
e44.task = new NotionPublishService.TaskSection();
e44.task.goal = 'Restructure the TechnoStore SFDX project into 5 distinct package directories declared in sfdx-project.json: force-app (default â€” sObjects, fields, layouts, flows), force-app-controllers (Visualforce controllers + REST endpoints), force-app-services (Apex services for callouts to external systems), force-app-handlers (TriggerHandler base + per-sObject handler classes), force-app-actions (@InvocableMethod classes called from Flow). Tests live next to their target class in each package.';
e44.task.constraints = 'sfdx-project.json packageDirectories array supports multiple entries with path + default flag (one must be default). All packageDirectories must be under the SFDX project root and contain a main/default structure. SFDX CLI commands (sf project deploy, sf project retrieve) operate on packageDirectories â€” deploying a single directory deploys only its contents. Cross-directory class references are allowed by Apex but logically discouraged within the architectural pattern.';
e44.task.successCriteria = 'sfdx-project.json contains 5 packageDirectories with path + default settings. Each directory has main/default/classes/ subfolder containing the appropriately-classified Apex classes. Existing Apex classes redistributed per their architectural role. sf project deploy start --source-dir force-app-services/main/default/classes/MyService.cls works for targeted deploys. Source-tracking via SFDX tracks changes per package directory.';
e44.action = new NotionPublishService.ActionSection();
e44.action.approach = 'Updated sfdx-project.json with 5-entry packageDirectories array. Created the 4 new directories (force-app-controllers, force-app-services, force-app-handlers, force-app-actions) each with main/default/classes/ structure. Moved existing Apex classes per architectural role: VF controllers â†’ force-app-controllers, external-API callout services â†’ force-app-services, trigger handlers â†’ force-app-handlers, @InvocableMethod Flow actions â†’ force-app-actions. Tests stay next to their target class. Updated CLAUDE.md to document the layout for future AI sessions.';
e44.action.implementation = new List<String>{
    'Updated sfdx-project.json with 5-entry packageDirectories array: force-app (default), force-app-controllers, force-app-services, force-app-handlers, force-app-actions',
    'Created 4 new directory structures: each with main/default/classes/ subfolder following Salesforce metadata API conventions',
    'force-app/ â€” sObjects (Product2 customizations, Custom Metadata Types), fields, layouts, flows, permission sets, page layouts, Site definitions, eSignatureConfigs, approvalProcesses, quickActions, named credentials, static resources',
    'force-app-controllers/ â€” Visualforce controllers (ContractPdfController, WarehouseInventoryApprovalController), REST resources (@RestResource classes like DocuSignWebhookController), all classes that own request/response cycle',
    'force-app-services/ â€” Apex services for external API callouts: NotionPublishService (entry 5 + this docs pipeline), DocuSignSendService (entry 27), JiraTicketService (entry 39), JiraSprintService (entry 40), AttributePricingHandler (entry 14) â€” all classes that own outbound HTTP',
    'force-app-handlers/ â€” TriggerHandler base class (Kevin O\'Hara, MIT) + per-sObject handlers: OrderTriggerHandler, QuoteLineItemTriggerHandler, ContractTriggerHandler, DocuSignSignedHandler (Platform Event subscriber) â€” all classes that wrap Trigger.* context',
    'force-app-actions/ â€” @InvocableMethod classes called from Flow: AttachAndEmailInvoicePreview (entry 32), EmailWithBrandedPdf (entry 32) â€” all classes exposing FlowAction surface to Lightning Flow',
    'Tests live next to their target class in the same package: OrderTriggerHandlerTest.cls in force-app-handlers/.../classes/, DocuSignSendServiceTest.cls in force-app-services/.../classes/',
    'Migrated existing class files via SFDX CLI mv: moved each .cls + .cls-meta.xml pair into appropriate target directory',
    'Updated CLAUDE.md to document the layout: includes a class-to-folder map enumerating each Apex class and its target directory',
    'Verified deploys still work after restructure: sf project deploy start --target-org admin@technostore.example (full deploy) succeeded; sf project deploy start --source-dir force-app-services/ deploys only that subdirectory'
};
NotionPublishService.CodeSnippet e44c1 = new NotionPublishService.CodeSnippet();
e44c1.caption = 'sfdx-project.json + directory structure';
e44c1.language = 'json';
e44c1.code = '{\n    "packageDirectories": [\n        { "path": "force-app", "default": true },\n        { "path": "force-app-controllers" },\n        { "path": "force-app-services" },\n        { "path": "force-app-handlers" },\n        { "path": "force-app-actions" }\n    ],\n    "namespace": "",\n    "sfdcLoginUrl": "https://login.salesforce.com",\n    "sourceApiVersion": "60.0"\n}\n\n// Directory tree after restructure:\n//\n// TechnoStore/\n// â”œâ”€â”€ sfdx-project.json\n// â”œâ”€â”€ force-app/                        # sObjects + UI + metadata\n// â”‚   â””â”€â”€ main/default/\n// â”‚       â”œâ”€â”€ objects/\n// â”‚       â”œâ”€â”€ fields/\n// â”‚       â”œâ”€â”€ layouts/\n// â”‚       â”œâ”€â”€ flows/\n// â”‚       â”œâ”€â”€ permissionsets/\n// â”‚       â”œâ”€â”€ staticresources/\n// â”‚       â””â”€â”€ ...\n// â”œâ”€â”€ force-app-controllers/            # VF + REST endpoints\n// â”‚   â””â”€â”€ main/default/classes/\n// â”‚       â”œâ”€â”€ ContractPdfController.cls\n// â”‚       â”œâ”€â”€ WarehouseInventoryApprovalController.cls\n// â”‚       â””â”€â”€ DocuSignWebhookController.cls\n// â”œâ”€â”€ force-app-services/               # External API callouts\n// â”‚   â””â”€â”€ main/default/classes/\n// â”‚       â”œâ”€â”€ NotionPublishService.cls\n// â”‚       â”œâ”€â”€ DocuSignSendService.cls\n// â”‚       â”œâ”€â”€ JiraTicketService.cls\n// â”‚       â”œâ”€â”€ JiraSprintService.cls\n// â”‚       â””â”€â”€ AttributePricingHandler.cls\n// â”œâ”€â”€ force-app-handlers/               # TriggerHandler + per-sObject\n// â”‚   â””â”€â”€ main/default/classes/\n// â”‚       â”œâ”€â”€ TriggerHandler.cls         # Kevin O\'Hara base (MIT)\n// â”‚       â”œâ”€â”€ OrderTriggerHandler.cls\n// â”‚       â”œâ”€â”€ QuoteLineItemTriggerHandler.cls\n// â”‚       â”œâ”€â”€ ContractTriggerHandler.cls\n// â”‚       â””â”€â”€ DocuSignSignedHandler.cls\n// â””â”€â”€ force-app-actions/                # @InvocableMethod for Flow\n//     â””â”€â”€ main/default/classes/\n//         â”œâ”€â”€ AttachAndEmailInvoicePreview.cls\n//         â””â”€â”€ EmailWithBrandedPdf.cls';
e44.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e44c1 };
e44.result = new NotionPublishService.ResultSection();
e44.result.outcome = 'TechnoStore SFDX project restructured into 5 packageDirectories with clear architectural ownership: force-app (metadata + sObjects), force-app-controllers (UI + REST), force-app-services (external API callouts), force-app-handlers (TriggerHandler + per-sObject), force-app-actions (Flow @InvocableMethods). Existing Apex classes redistributed per role. Targeted deploys work (sf project deploy --source-dir force-app-services/). Architecture is recognizable to enterprise Salesforce engineers as production-grade separation of concerns.';
e44.result.tradeoffsAndLessons = 'Multi-package SFDX layout is the Salesforce-native equivalent of multi-module Maven or multi-project Gradle builds. The architectural signal value alone justifies the small overhead (5 directories vs 1). The clear ownership of "which folder does new code go in?" question reduces cognitive load for the developer. Recruiters who know Spring Boot multi-module patterns recognize the parallel immediately. The class-to-folder map in CLAUDE.md is the documentation that holds it all together â€” without that, the layout drifts.';
e44.result.references = new List<String>{
    'sfdx-project.json (5 packageDirectories)',
    'Memory: enterprise_apex_layout.md (full class-to-folder map)',
    'CLAUDE.md (project context â€” directory structure documented)',
    'Salesforce SFDX project structure documentation'
};
e44.result.futureWork = 'Add force-app-tests/ as 6th package directory holding ALL test classes (currently tests live next to target class). This enables test-only deploys for CI/CD pipelines (run all tests before any production deploy). Tradeoff: loses the proximity of test-next-to-target which helps maintainability â€” defer this restructure to a production-readiness phase.';
entries.add(e44);

// ============ Publish ============
Integer success = 0;
Integer failed = 0;
for (Integer i = 0; i < entries.size(); i++) {
    NotionPublishService.EnterpriseEntry e = entries.get(i);
    try {
        String pageId = NotionPublishService.publishEnterprise(e);
        System.debug('OK [' + (i+1) + '/' + entries.size() + '] ' + e.title + ' -> ' + pageId);
        success++;
    } catch (Exception ex) {
        System.debug('FAIL [' + (i+1) + '/' + entries.size() + '] ' + e.title + ' - ' + ex.getMessage());
        failed++;
    }
}
System.debug('=== BATCH 16 COMPLETE (entries 43-44) === Success: ' + success + ' / Failed: ' + failed);
