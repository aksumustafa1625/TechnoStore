// Enterprise STAR entries 25-27: Phase 4 External Integrations start

List<NotionPublishService.EnterpriseEntry> entries = new List<NotionPublishService.EnterpriseEntry>();

// ============ 25. MuleSoft Auth Setup ============
NotionPublishService.EnterpriseEntry e25 = new NotionPublishService.EnterpriseEntry();
e25.title = '25. MuleSoft Auth Setup â€” External Client App + 3-Email Matrix';
e25.situation = new NotionPublishService.SituationSection();
e25.situation.context = 'MuleSoft Anypoint Studio is the orchestration layer for TechnoStore\'s external integrations (Stripe payment intents, Sendcloud v3 orders, Slack webhooks). Mule connects to Salesforce via the Salesforce Connector which requires OAuth credentials â€” specifically a Connected App or its modern replacement, the External Client App. Mule runs in the Anypoint EU region and must authenticate as a runtime user with API + Apex access scopes.';
e25.situation.problem = 'Classic Connected App creation was blocked on our Salesforce Dev Edition org (security policy in this trial mandates the new External Client App for new integrations â€” Connected App API endpoint returns 403). Three different Anypoint accounts existed for distinct org reasons (admin@technostore.example vs anypoint-admin@technostore.example vs demo@technostore.example). PKCE (Proof Key for Code Exchange) was enabled by default on the External Client App, but MuleSoft HTTP Connector does NOT support PKCE challenge/verifier flow â€” must disable PKCE to enable username-password OAuth.';
e25.task = new NotionPublishService.TaskSection();
e25.task.goal = 'Get MuleSoft Anypoint Studio connecting to Salesforce successfully via OAuth username-password flow without PKCE blocking, working through the new External Client App API rather than the legacy Connected App path. Establish a clear 3-email role matrix for who owns what credential.';
e25.task.constraints = 'External Client App is the new Salesforce primitive (replacing Connected App) â€” different Setup URL path (Setup â†’ External Client Apps, NOT Setup â†’ Apps â†’ Connected Apps). PKCE must be explicitly disabled in the OAuth Settings tab. The OAuth runtime user (admin@technostore.example) must have profile + permission set granting "API Enabled" + "Apex Class Access" + the required Salesforce object FLS. Mule must whitelist Anypoint EU IP range in Salesforce Network Access settings.';
e25.task.successCriteria = 'Mule Anypoint Studio Salesforce Connector authenticates against Dev Edition org without PKCE rejection. Token refresh handles 24-hour Anypoint session lifecycle automatically. Salesforce inbound API calls from Mule resolve under the admin@technostore.example runtime user. SOQL/DML/Platform Event subscription operations work from Mule flows.';
e25.action = new NotionPublishService.ActionSection();
e25.action.approach = 'Created External Client App in Setup â†’ External Client Apps with explicit PKCE-disabled configuration. Established 3-email role matrix to clarify ownership: admin@technostore.example = Salesforce OAuth runtime user (Mule authenticates AS this user), anypoint-admin@technostore.example = Anypoint Platform admin (owns the Anypoint org + Mule project), demo@technostore.example = External Client App contact-only (cannot log in but receives security notifications).';
e25.action.implementation = new List<String>{
    'Setup â†’ External Client Apps â†’ New: Name=TechnoStore_Mule_Integration, Description=Mule connector for Stripe/Sendcloud/Slack/Platform Events',
    'OAuth Settings tab: Enable OAuth=true, Callback URL=https://login.salesforce.com/services/oauth2/success (placeholder, Mule uses username-password flow), Selected OAuth Scopes=api + refresh_token + offline_access + cdp_api',
    'IMPORTANT: PKCE Required For Supported OAuth Flows = FALSE (default is true â€” must explicitly uncheck). Mule HTTP Connector does NOT support PKCE; leaving this on causes silent 401 rejection of token endpoint requests',
    'Generated Consumer Key + Consumer Secret pair (sf.client.id + sf.client.secret in mule-app.properties)',
    'Established 3-email role matrix: admin@technostore.example (System Administrator profile, OAuth runtime user) + anypoint-admin@technostore.example (Anypoint Platform admin, owns Mule artifacts in Anypoint Exchange) + demo@technostore.example (contact-only on External Client App for security notifications, no Salesforce login)',
    'Whitelisted Anypoint EU runtime IP range in Setup â†’ Security â†’ Network Access â€” Anypoint EU is in CIDR 52.16.0.0/16 + others (per current Anypoint published IPs)',
    'Configured Mule sfdc:config in TechnoStore-mule project: oauth-username-password element with consumerKey + consumerSecret + username + password + tokenEndpoint=login.salesforce.com',
    'mule-app.properties (gitignored): contains sf.client.id, sf.client.secret, sf.username, sf.password, sf.security.token â€” never committed to git',
    'Verified Mule polling works: deployed test flow that queries SELECT COUNT() FROM Account â†’ returned 4 (matches the 4 DACH accounts)',
    'Token refresh validated: ran Mule polling for 24+ hours without re-auth, OAuth refresh fired transparently'
};
NotionPublishService.CodeSnippet e25c1 = new NotionPublishService.CodeSnippet();
e25c1.caption = 'Mule Salesforce Connector OAuth config (XML)';
e25c1.language = 'xml';
e25c1.code = '<!-- src/main/mule/global-config.xml -->\n<sfdc:config name="Salesforce_Config" doc:name="Salesforce Config">\n    <sfdc:oauth-username-password\n        consumerKey="${sf.client.id}"\n        consumerSecret="${sf.client.secret}"\n        username="${sf.username}"\n        password="${sf.password}${sf.security.token}"\n        tokenEndpoint="https://login.salesforce.com/services/oauth2/token"\n        apiVersion="60.0"\n        readTimeout="60000"\n        connectionTimeout="30000"/>\n</sfdc:config>\n\n<!-- src/main/resources/mule-app.properties (gitignored â€” NEVER commit) -->\nsf.client.id=3MVG9...   # External Client App Consumer Key\nsf.client.secret=...   # External Client App Consumer Secret\nsf.username=admin@technostore.example\nsf.password=YourPasswordHere  # Salesforce user password\nsf.security.token=...  # Salesforce security token (from My Personal Information)\n\n<!-- src/main/mule/flows/example-query.xml -->\n<flow name="poll-salesforce-accounts">\n    <scheduler doc:name="Every 5 minutes">\n        <scheduling-strategy>\n            <fixed-frequency frequency="5" timeUnit="MINUTES"/>\n        </scheduling-strategy>\n    </scheduler>\n    <sfdc:query config-ref="Salesforce_Config" doc:name="Query Accounts">\n        <sfdc:salesforce-query>SELECT Id, Name, NumberOfEmployees FROM Account WHERE Type = \'Customer\'</sfdc:salesforce-query>\n    </sfdc:query>\n    <logger message="#[payload]" level="INFO"/>\n</flow>';
e25.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e25c1 };
e25.result = new NotionPublishService.ResultSection();
e25.result.outcome = 'Mule Anypoint Studio connects to Salesforce via OAuth without PKCE rejection. Token refresh smoothly handles 24-hour Anypoint Studio session lifecycle. Three-email role matrix avoids the single-account auth bottleneck that plagues many MuleSoft + Salesforce integrations. All downstream Mule flows (Stripe / Sendcloud / Slack / Platform Event subscribers) authenticate correctly as the admin@technostore.example runtime user.';
e25.result.tradeoffsAndLessons = 'External Client App vs Connected App is a transition area in Salesforce â€” most documentation still references Connected App but new orgs increasingly default to External Client App with PKCE on. The PKCE-off requirement is the kind of gotcha that costs ~2 hours the first time and is documented for the team forever. The 3-email role matrix (runtime user / platform admin / contact-only) is a clean separation-of-duties pattern that scales beyond this single Mule connector â€” same matrix works for DocuSign API, Stripe API, JIRA API integrations.';
e25.result.references = new List<String>{
    'Memory: mulesoft_integration_setup.md (3-email matrix + PKCE OFF + IP whitelist)',
    'Setup -> External Client Apps -> TechnoStore_Mule_Integration',
    'mule-app.properties (gitignored â€” see .gitignore for pattern)',
    'Anypoint EU region published IP ranges (whitelist source)'
};
e25.result.futureWork = 'Migrate Mule to JWT Bearer Flow for production (Salesforce-recommended over username-password). JWT eliminates the security.token concatenation and works with stricter Salesforce orgs. Pattern: generate RSA keypair, register public key on External Client App, sign JWT with private key, exchange for access_token.';
entries.add(e25);

// ============ 26. MuleSoft Anypoint Studio vs Code Builder Decision ============
NotionPublishService.EnterpriseEntry e26 = new NotionPublishService.EnterpriseEntry();
e26.title = '26. MuleSoft Anypoint Studio vs Code Builder â€” 8 Hour Failure + Pivot Decision';
e26.situation = new NotionPublishService.SituationSection();
e26.situation.context = 'MuleSoft offers two development environments: (a) Anypoint Studio â€” the mature Eclipse-based IDE with visual flow designer, established since 2014 â€” and (b) Code Builder â€” the new VS Code extension, GA since 2024, marketed as the modern replacement for Studio. Code Builder promised faster startup, cloud-native deployment via Anypoint Exchange, and better git integration. The initial demo plan chose Code Builder for the "newer = better" assumption.';
e26.situation.problem = 'Code Builder deployment path failed repeatedly over 8+ hours of investigation: Maven build errors (missing transitive dependencies), JAR packaging errors (incorrect manifest), deployment errors to CloudHub 2.0 runtime (502 Bad Gateway from the management plane), authentication errors with Anypoint Exchange OAuth. Stack Overflow and Anypoint Community had reports of similar issues but no consistent resolution. Each Code Builder release seemed to introduce new breakage. Decision needed: continue investing in Code Builder or pivot to Anypoint Studio (mature, well-documented, more boring but reliable).';
e26.task = new NotionPublishService.TaskSection();
e26.task.goal = 'Make a defensible architecture decision: continue debugging Code Builder (risk: more time lost, potentially never working) or pivot to Anypoint Studio (cost: re-create project artifacts, lose 4 hours of Code Builder setup time but gain reliable deployment). Document the rationale so the decision is auditable and reproducible by future engineers facing the same choice.';
e26.task.constraints = 'Time budget: 4 weeks remaining in the demo prep phase. MuleSoft is one of 5+ integration paths to build; cannot afford to spend additional 8+ hours on tooling debate. Demo recording must be production-grade quality, not a debugging-session-with-fingers-crossed.';
e26.task.successCriteria = 'A working MuleSoft project that deploys reliably to a Mule runtime, connects to Salesforce + Stripe + Sendcloud + Slack, and survives a demo recording without breaking. Tooling choice documented with rationale for future engineers.';
e26.action = new NotionPublishService.ActionSection();
e26.action.approach = 'After 8 hours of Code Builder failure, pivoted to Anypoint Studio 7.x (mature, Eclipse-based). Recreated the project structure in Studio in ~3 hours: imported the .mule project descriptor, re-built the SF Connector + HTTP Listener + DataWeave transforms. Tested local deployment via Mule Standalone runtime, confirmed all flows function. Deployed to CloudHub 1.0 (older but stable) instead of CloudHub 2.0 (which had been the Code Builder target).';
e26.action.implementation = new List<String>{
    'Documented Code Builder failure timeline: 8+ hours across Maven dependency resolution, JAR packaging, CloudHub 2.0 deployment, Anypoint Exchange auth â€” no consistent resolution despite trying multiple approaches',
    'Decision made to pivot to Anypoint Studio 7.x â€” mature, Eclipse-based, visual flow designer, well-documented, larger community',
    'Installed Anypoint Studio 7.16 on Windows, configured embedded Maven, registered Anypoint Platform credentials',
    'Recreated TechnoStore Mule project: imported global-config.xml (Salesforce Connector from entry 25), HTTP Listener configs for Stripe webhook + Sendcloud, DataWeave transforms for each external system\'s payload schema',
    'Built 6 core Mule flows: SF Account polling, Stripe PaymentIntent create (HTTP outbound), Stripe webhook receiver (HTTP listener), Sendcloud v3 order create, Slack #payments-team notification, Slack #warehouse Platform Event subscriber',
    'Tested local deployment via Mule Standalone 4.4.x runtime â€” all 6 flows started successfully, port 8081 served HTTP Listener, no errors in mule_ee.log',
    'Deployed to CloudHub 1.0 (legacy but stable) via Anypoint Runtime Manager â€” chose CloudHub 1.0 over 2.0 because 2.0 was the Code Builder target that had failed; CloudHub 1.0 has 5+ years of production maturity',
    'Verified end-to-end: triggered SF Platform Event from Apex anonymous â†’ Mule subscriber received within 3 seconds â†’ Slack webhook posted to #warehouse â†’ Slack message visible in browser',
    'Total time pivot cost: 8 hours Code Builder + 3 hours Anypoint Studio rebuild + 1 hour verification = 12 hours. If Code Builder had worked first try, would have been ~4 hours. Net loss: 8 hours. Worth it for reliable demo'
};
NotionPublishService.CodeSnippet e26c1 = new NotionPublishService.CodeSnippet();
e26c1.caption = 'Anypoint Studio project structure (re-creation)';
e26c1.language = 'plain text';
e26c1.code = 'technostore-mule/\nâ”œâ”€â”€ pom.xml                          # Maven build descriptor\nâ”œâ”€â”€ mule-artifact.json               # Mule app metadata\nâ”œâ”€â”€ src/main/mule/\nâ”‚   â”œâ”€â”€ global-config.xml            # SF Connector + HTTP Listener configs\nâ”‚   â”œâ”€â”€ flows/\nâ”‚   â”‚   â”œâ”€â”€ poll-salesforce.xml      # 5-min SF Account poll\nâ”‚   â”‚   â”œâ”€â”€ stripe-paymentintent.xml # Outbound to Stripe API\nâ”‚   â”‚   â”œâ”€â”€ stripe-webhook.xml       # Inbound from Stripe events\nâ”‚   â”‚   â”œâ”€â”€ sendcloud-orders.xml     # Outbound to Sendcloud v3\nâ”‚   â”‚   â”œâ”€â”€ slack-payments.xml       # Outbound to #payments-team\nâ”‚   â”‚   â””â”€â”€ slack-warehouse.xml      # Platform Event subscriber + Slack\nâ”œâ”€â”€ src/main/resources/\nâ”‚   â”œâ”€â”€ mule-app.properties          # GITIGNORED â€” secrets only\nâ”‚   â”œâ”€â”€ application-types.xml        # DataWeave type registry\nâ”‚   â””â”€â”€ log4j2.xml                   # Mule logging config\nâ””â”€â”€ src/test/resources/\n    â”œâ”€â”€ munit-suites/                # Mule unit test suites\n    â””â”€â”€ munit-resources/             # Test fixtures\n\n# Deployment: \n# - Local: Run Configurations â†’ Mule Application â†’ Run As â†’ Mule Application\n# - CloudHub 1.0: Right-click project â†’ Anypoint Platform â†’ Deploy to CloudHub';
e26.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e26c1 };
e26.result = new NotionPublishService.ResultSection();
e26.result.outcome = 'Anypoint Studio 7.16 hosts the TechnoStore Mule project successfully. 6 production-grade flows deployed to CloudHub 1.0 within 3 hours of pivot decision. All flows operate reliably: SF Account poll runs every 5 minutes without errors, Stripe webhook responds in <500ms, Sendcloud v3 order creation works on every test, Slack notifications post within 3 seconds. Demo recording capability secured. Code Builder remains documented as a "not-ready-yet" option for future re-evaluation.';
e26.result.tradeoffsAndLessons = 'Tool newness is not value. Code Builder is the future of Mule development but the future has not arrived in mid-2026 for production-grade work. Anypoint Studio is "boring" â€” well-documented, predictable, slower to start (~30s vs Code Builder ~5s) but never silently breaks. The 8 hour failure has explanatory value in the demo narrative: it shows the engineer can recognize sunk-cost fallacy and pivot. The decision to use CloudHub 1.0 over 2.0 follows the same logic: maturity beats novelty for demo reliability. Pattern: when a new tool/runtime has <2 years of production maturity, default to the older option unless the new one offers something the old one cannot do at all.';
e26.result.references = new List<String>{
    'Anypoint Studio 7.x download + setup',
    'CloudHub 1.0 vs 2.0 â€” Mule runtime targets',
    'MuleSoft Code Builder community reports of similar failures (Anypoint Exchange forum)',
    'technostore-mule/ project structure (Anypoint Studio standard)'
};
e26.result.futureWork = 'Re-evaluate Code Builder + CloudHub 2.0 in Q4 2026 after 12+ months of additional GA hardening. If failure modes have been resolved, migrate the TechnoStore Mule project (pattern: Code Builder import-from-Studio is supported, low migration cost).';
entries.add(e26);

// ============ 27. DocuSign Outbound â€” Apex Callout via Named Credential ============
NotionPublishService.EnterpriseEntry e27 = new NotionPublishService.EnterpriseEntry();
e27.title = '27. DocuSign Outbound â€” Apex Callout via Named Credential + Anchor Tabs';
e27.situation = new NotionPublishService.SituationSection();
e27.situation.context = 'TechnoStore Q2C flow requires sending the activated Contract PDF to the customer for electronic signature. DocuSign is the industry-standard e-signature provider with REST API at account.docusign.com/restapi/v2.1/accounts/{accountId}/envelopes. The Apex callout pattern via Named Credential is the production-grade approach: Named Credential stores the OAuth2 JWT-bearer flow tokens, Apex callout via callout:DocuSign_API/* resolves to the Named Credential endpoint without hardcoded URLs.';
e27.situation.problem = 'Initial attempt used the native CLM Send for Signature button on Contract layout â€” silently failed (no error, no envelope, no status change). After 7 hypothesis iterations and documentation deep-dive, confirmed via Salesforce docs that the CLM Send for Signature button LegalName auto-fill is intentionally disabled for Signer type recipients (Signer Name field is meant to be blank at template-binding time, populated by the recipient when they sign). The "fix" is therefore "build your own Send UI" â€” Salesforce explicitly documents this as the intended architectural pattern for non-trivial Sign workflows.';
e27.task = new NotionPublishService.TaskSection();
e27.task.goal = 'Build a custom DocuSignSendService Apex class that constructs an envelope via DocuSign REST API, includes the branded Contract PDF as base64-encoded document, configures Anchor Tab signing fields, sends the envelope (Status=sent), and stores the returned envelopeId on Contract.DocuSign_Envelope_Id__c for later webhook correlation. Invoked from a custom Send_For_Signature screen flow on Contract (entry 24).';
e27.task.constraints = 'DocuSign envelope payload size limit: 25 MB total (document + recipients + tabs). PDF bytes must be base64-encoded (1.33x size inflation, our typical Contract PDF is 300KB â†’ ~400KB base64). Anchor Tab strings must be unique within the document to avoid ambiguous placement. Named Credential OAuth refresh requires the DocuSign integration key + RSA private key pair stored as Custom Setting (DocuSign_Config__c protected hierarchy CustomSetting). Apex callout timeout 120 seconds (governor) â€” sufficient for DocuSign envelope creation typical 2-5 second latency.';
e27.task.successCriteria = 'Clicking Send For Signature on a Contract page â†’ screen flow opens confirmation â†’ DocuSignSendService.sendEnvelope() fires â†’ DocuSign returns envelopeId within 3 seconds â†’ Contract.Status flips to Awaiting Signature â†’ customer receives DocuSign signing email within 30 seconds â†’ customer clicks Sign Here on the Anchor Tab â†’ signature applied. End-to-end takes <1 minute.';
e27.action = new NotionPublishService.ActionSection();
e27.action.approach = 'Built DocuSignSendService.cls with sendEnvelope(Id contractId, String signerEmail, String signerName) static method. Reads the branded Contract PDF from ContentVersion linked to Contract, base64-encodes the bytes, constructs envelope JSON with documents + recipients + tabs (Anchor Tab on "Authorized Signature:" text in the PDF footer), POSTs to callout:DocuSign_API/v2.1/accounts/{accountId}/envelopes, parses the envelopeId from response, updates Contract.DocuSign_Envelope_Id__c + Contract.Status=Awaiting Signature.';
e27.action.implementation = new List<String>{
    'Created Named Credential DocuSign_API: URL=https://demo.docusign.net (sandbox during dev, account-d.docusign.com for production), Identity Type=Named Principal, Authentication Protocol=OAuth 2.0',
    'Configured OAuth via External Credential: JWT Bearer Flow targeting DocuSign Auth Server (account-d.docusign.com/oauth/token), RSA private key in Auth Provider, integration key as client_id',
    'Created DocuSign_Config__c protected Hierarchy Custom Setting with fields Account_Id__c (DocuSign API account UUID) + Base_URL__c + Integration_Key__c (gitignored setup script populates these)',
    'Built DocuSignSendService.cls with static sendEnvelope() method: queries ContentVersion VersionData for Contract PDF, base64-encodes, constructs envelope payload with documents + recipients + tabs',
    'Recipient config: Type=signer, RoutingOrder=1, RecipientId=1, Email=signerEmail, Name=signerName (passed from Contract.BillToContact.Name)',
    'Tabs config: Anchor Tab on "Authorized Signature:" string in the PDF (unique substring guarantees placement on the right line), AnchorYOffset=0, AnchorXOffset=200, AnchorUnits=pixels',
    'POST request: setEndpoint(callout:DocuSign_API/v2.1/accounts/+accountId+/envelopes), setMethod(POST), setHeader Content-Type=application/json, setBody(JSON.serialize(envelope)), setTimeout(60000)',
    'Parse response: extract envelopeId from JSON body, update Contract.DocuSign_Envelope_Id__c + Contract.Status=Awaiting Signature in single DML',
    'Wired invocation from Send_For_Signature screen flow (entry 24) via Apex Action â€” flow passes Contract.Id + signerEmail + signerName',
    'Verified end-to-end: Contract â†’ Send For Signature â†’ DocuSign envelope sent â†’ customer receives email at signerEmail â†’ clicks Sign â†’ applies signature on Anchor Tab â†’ envelope status flips to Completed in DocuSign'
};
NotionPublishService.CodeSnippet e27c1 = new NotionPublishService.CodeSnippet();
e27c1.caption = 'DocuSignSendService.cls â€” envelope creation';
e27c1.language = 'java';
e27c1.code = 'public with sharing class DocuSignSendService {\n\n    public static String sendEnvelope(Id contractId, String signerEmail, String signerName) {\n        DocuSign_Config__c cfg = DocuSign_Config__c.getOrgDefaults();\n        if (cfg == null || String.isBlank(cfg.Account_Id__c)) {\n            throw new DocuSignSendException(\'DocuSign_Config__c missing Account_Id__c\');\n        }\n\n        // 1. Load branded Contract PDF from ContentVersion\n        ContentVersion cv = [\n            SELECT VersionData, Title\n            FROM ContentVersion\n            WHERE FirstPublishLocationId = :contractId\n            ORDER BY CreatedDate DESC LIMIT 1\n        ];\n\n        // 2. Construct envelope payload\n        Map<String, Object> envelope = new Map<String, Object>{\n            \'emailSubject\' => \'TechnoStore Contract â€” Signature Required\',\n            \'emailBlurb\' => \'Please review and sign the attached contract.\',\n            \'documents\' => new List<Object>{\n                new Map<String, Object>{\n                    \'documentBase64\' => EncodingUtil.base64Encode(cv.VersionData),\n                    \'name\' => cv.Title + \'.pdf\',\n                    \'fileExtension\' => \'pdf\',\n                    \'documentId\' => \'1\'\n                }\n            },\n            \'recipients\' => new Map<String, Object>{\n                \'signers\' => new List<Object>{\n                    new Map<String, Object>{\n                        \'email\' => signerEmail,\n                        \'name\' => signerName,\n                        \'recipientId\' => \'1\',\n                        \'routingOrder\' => \'1\',\n                        \'tabs\' => new Map<String, Object>{\n                            \'signHereTabs\' => new List<Object>{\n                                new Map<String, Object>{\n                                    \'anchorString\' => \'Authorized Signature:\',\n                                    \'anchorYOffset\' => \'0\',\n                                    \'anchorXOffset\' => \'200\',\n                                    \'anchorUnits\' => \'pixels\'\n                                }\n                            }\n                        }\n                    }\n                }\n            },\n            \'status\' => \'sent\'\n        };\n\n        // 3. Send to DocuSign via Named Credential\n        HttpRequest req = new HttpRequest();\n        req.setEndpoint(\'callout:DocuSign_API/v2.1/accounts/\' + cfg.Account_Id__c + \'/envelopes\');\n        req.setMethod(\'POST\');\n        req.setHeader(\'Content-Type\', \'application/json\');\n        req.setBody(JSON.serialize(envelope));\n        req.setTimeout(60000);\n\n        HttpResponse resp = new Http().send(req);\n        if (resp.getStatusCode() < 200 || resp.getStatusCode() >= 300) {\n            throw new DocuSignSendException(\'DocuSign HTTP \' + resp.getStatusCode() + \': \' + resp.getBody());\n        }\n        Map<String, Object> parsed = (Map<String, Object>) JSON.deserializeUntyped(resp.getBody());\n        String envelopeId = (String) parsed.get(\'envelopeId\');\n\n        // 4. Persist envelopeId + flip Contract.Status\n        update new Contract(\n            Id = contractId,\n            DocuSign_Envelope_Id__c = envelopeId,\n            Status = \'Awaiting Signature\'\n        );\n        return envelopeId;\n    }\n\n    public class DocuSignSendException extends Exception {}\n}';
e27.action.codeSnippets = new List<NotionPublishService.CodeSnippet>{ e27c1 };
e27.result = new NotionPublishService.ResultSection();
e27.result.outcome = 'DocuSign envelope sent reliably from custom Send For Signature button on Contract. Customer receives DocuSign signing email within 30 seconds. Anchor Tab places the sign-here field correctly on the Contract PDF signature line. Contract.Status flips to Awaiting Signature visible to all sales team. envelopeId stored on Contract.DocuSign_Envelope_Id__c for later inbound webhook correlation (entry 28). End-to-end Send-to-Signed cycle completes in under 5 minutes with customer action.';
e27.result.tradeoffsAndLessons = 'Named Credential is the right abstraction for OAuth-protected external APIs â€” it isolates auth from business logic, supports automatic token refresh, and replaces hardcoded URLs with callout:Name aliases. Building DocuSignSendService.cls instead of using the native CLM Send button took ~4 hours but unlocked full control: custom subject lines, custom blurb text, custom anchor placement, custom routing order. The DocuSign Anchor Tab pattern (place signing fields by searching for unique strings in the document) is more flexible than position-based tabs because it survives document reformatting.';
e27.result.references = new List<String>{
    'force-app-services/main/default/classes/DocuSignSendService.cls',
    'Named Credential DocuSign_API (callout: alias)',
    'DocuSign REST API v2.1 envelopes endpoint',
    'Memory: docusign_integration_progress.md (full bidirectional integration)'
};
e27.result.futureWork = 'Add multi-signer support: route Contract to manager â†’ legal â†’ CFO sequentially via DocuSign recipient routingOrder cascading values. Currently single-signer demo. Pattern: extend signers list with routingOrder=1/2/3, set routingOrder on each Anchor Tab.';
entries.add(e27);

// ============ Publish ============
Integer success = 0;
Integer failed = 0;
for (Integer i = 0; i < entries.size(); i++) {
    NotionPublishService.EnterpriseEntry e = entries.get(i);
    try {
        String pageId = NotionPublishService.publishEnterprise(e);
        System.debug('OK [' + (i+1) + '/' + entries.size() + '] ' + e.title + ' -> ' + pageId);
        success++;
    } catch (Exception ex) {
        System.debug('FAIL [' + (i+1) + '/' + entries.size() + '] ' + e.title + ' - ' + ex.getMessage());
        failed++;
    }
}
System.debug('=== BATCH 8 COMPLETE (entries 25-27) === Success: ' + success + ' / Failed: ' + failed);
