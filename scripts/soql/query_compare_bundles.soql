SELECT ParentProduct.Name, ChildProduct.Name, ProductComponentGroup.Name, ProductComponentGroup.MinBundleComponents, ProductComponentGroup.MaxBundleComponents, Quantity, MinQuantity, MaxQuantity, IsComponentRequired, IsDefaultComponent, DoesBundlePriceIncludeChild FROM ProductRelatedComponent WHERE ParentProduct.Name IN ('Laptop Basic Bundle','Laptop Pro Bundle','Home Office Bundle','Printer Bundle') ORDER BY ParentProduct.Name, Sequence
