SELECT Id, ContextAttribute.Title, ContextInputAttributeName, ContextNodeMapping.Object, ContextNodeMapping.ContextMapping.Title, ContextNodeMapping.ContextMapping.ContextDefinitionVersion.VersionNumber, ContextNodeMapping.ContextMapping.ContextDefinitionVersion.IsActive FROM ContextAttributeMapping WHERE ContextAttribute.Title = 'Name' AND ContextNodeMapping.ContextMapping.Title LIKE '%ToCntr%' ORDER BY ContextNodeMapping.ContextMapping.ContextDefinitionVersion.VersionNumber